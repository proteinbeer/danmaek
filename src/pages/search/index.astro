---
import BaseLayout from '../../components/BaseLayout.astro';
import { SITE } from '../../consts';
import { getPosts } from '../../lib/posts';

const posts = getPosts().map((post) => ({
  title: post.data.title,
  description: post.data.description.trim(),
  category: post.data.category,
  tags: post.data.tags,
  image: post.data.image,
  imageAlt: post.data.imageAlt,
  date: post.data.date.toLocaleDateString('ko-KR'),
  dateTime: post.data.date.toISOString(),
  url: `/posts/${post.id}/`
}));
---
<BaseLayout title={`검색 | ${SITE.name}`} description="단맥 글을 검색합니다.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>
  <main class="container">
    <section class="hero">
      <p class="eyebrow">SEARCH</p>
      <h1>검색</h1>
      <p>이전 이슈를 빠르게 확인해 보세요.</p>
    </section>
    <section class="search-box">
      <label for="search-input">검색어</label>
      <input id="search-input" type="search" autocomplete="off" />
      <div id="search-results" aria-live="polite"></div>
    </section>
  </main>
  <script is:inline define:vars={{ posts }}>
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    function render(query = '') {
      const q = query.trim().toLowerCase();
      const matched = q ? posts.filter((post) => [post.title, post.description, post.category, post.tags.join(' ')].join(' ').toLowerCase().includes(q)) : posts;
      results.innerHTML = matched.map((post) => `
        <a class="search-result" href="${post.url}">
          <img src="${post.image}" alt="${post.imageAlt}" loading="lazy" decoding="async" />
          <span class="search-result__body">
            <strong>${post.title}</strong>
            <time datetime="${post.dateTime}">${post.date}</time>
          </span>
        </a>
      `).join('') || '<p>검색 결과가 없습니다.</p>';
    }
    input?.addEventListener('input', (event) => render(event.target.value));
    render();
  </script>
</BaseLayout>
