---
import BaseLayout from '../../components/BaseLayout.astro';
import { SITE } from '../../consts';
import { getPosts } from '../../lib/posts';
import { TOOLS } from '../../lib/tools';

const posts = getPosts().map((post) => ({
  title: post.data.title,
  description: post.data.description.trim(),
  category: post.data.category,
  tags: post.data.tags,
  image: post.data.image,
  imageAlt: post.data.imageAlt,
  date: post.data.date.toLocaleDateString('ko-KR'),
  dateTime: post.data.date.toISOString(),
  url: `/posts/${post.id}/`
}));

const tools = TOOLS.map((tool) => ({
  title: tool.title,
  description: tool.description,
  category: tool.category,
  icon: tool.icon,
  url: `/tools/${tool.slug}/`
}));
---
<BaseLayout title={`검색 | ${SITE.name}`} description="단맥 글과 도구를 검색합니다.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>
  <main class="container">
    <section class="container" aria-labelledby="search-title">
      <div class="section-head">
        <div>
          <h2 id="search-title">검색</h2>
        </div>
      </div>
      <article class="featured">
        <div class="search-box">
          <label for="search-input">검색어</label>
          <input id="search-input" type="search" autocomplete="off" />
          <div id="search-results" aria-live="polite"></div>
        </div>
      </article>
    </section>
    <div class="tool-coupang tool-coupang--sm">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021110,"template":"carousel","trackingCode":"AF7638395","width":"250","height":"250","tsource":""});
</script>
    </div>
    <div class="tool-coupang tool-coupang--lg">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021235,"trackingCode":"AF7638395","subId":null,"template":"carousel","width":"662","height":"140"});
</script>
    </div>
  </main>
  <script is:inline define:vars={{ posts, tools }}>
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    function render(query = '') {
      const q = query.trim().toLowerCase();
      if (!q) { results.innerHTML = ''; return; }
      const matchedPosts = posts.filter((post) => [post.title, post.description, post.category, post.tags.join(' ')].join(' ').toLowerCase().includes(q));
      const matchedTools = tools.filter((tool) => [tool.title, tool.description, tool.category].join(' ').toLowerCase().includes(q));
      let html = '';
      if (matchedPosts.length) {
        html += '<p class="search-section-label">글</p>';
        html += matchedPosts.map((post) => `
          <a class="search-result" href="${post.url}">
            <img src="${post.image}" alt="${post.imageAlt}" loading="lazy" decoding="async" />
            <span class="search-result__body">
              <strong>${post.title}</strong>
              <time datetime="${post.dateTime}">${post.date}</time>
            </span>
          </a>
        `).join('');
      }
      if (matchedTools.length) {
        html += '<p class="search-section-label">도구</p>';
        html += matchedTools.map((tool) => `
          <a class="search-result" href="${tool.url}">
            <span class="search-result__body" style="grid-column:1/-1;">
              <strong>${tool.icon} ${tool.title}</strong>
              <span style="color:var(--muted); font-size:.9rem;">${tool.description}</span>
            </span>
          </a>
        `).join('');
      }
      results.innerHTML = html || '<p>검색 결과가 없습니다.</p>';
    }
    input?.addEventListener('input', (event) => render(event.target.value));
    render();
  </script>
</BaseLayout>
