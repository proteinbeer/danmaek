---
import BaseLayout from '../../components/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, SITE } from '../../consts';
import { getPostsByCategory } from '../../lib/posts';

const category = CATEGORIES.find((item) => item.name === '드라마')!;
const posts = getPostsByCategory('드라마');
---
<BaseLayout title={`드라마 | ${SITE.name}`} description={category.description} canonical={new URL('/dramas/', SITE.url).toString()}>
  <main class="container">
    <section aria-label="드라마 글 목록">
      <div class="section-head">
        <div><h2>드라마</h2></div>
      </div>
      <div class="grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
    <div class="tool-coupang tool-coupang--sm">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021110,"template":"carousel","trackingCode":"AF7638395","width":"250","height":"250","tsource":""});
</script>
    </div>
    <div class="tool-coupang tool-coupang--lg">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021235,"trackingCode":"AF7638395","subId":null,"template":"carousel","width":"662","height":"140"});
</script>
    </div>
  </main>
</BaseLayout>
