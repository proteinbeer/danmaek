---
import BaseLayout from '../../components/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, GAME_SUBCATEGORIES, SITE } from '../../consts';
import { getPostsByCategory } from '../../lib/posts';

const category = CATEGORIES.find((item) => item.name === '게임')!;
const posts = getPostsByCategory('게임');
const subcats = [...GAME_SUBCATEGORIES];
---
<BaseLayout title={`게임 | ${SITE.name}`} description={category.description} canonical={new URL('/games/', SITE.url).toString()}>
  <main class="container">
    <div class="adfit-banner">
      <ins class="kakao_ad_area" style="display:none;"
        data-ad-unit="DAN-LoWQpAjT1C8qjOLo"
        data-ad-width="728"
        data-ad-height="90"></ins>
      <script is:inline async type="text/javascript" charset="utf-8" src="https://t1.kakaocdn.net/kas/static/ba.min.js"></script>
    </div>
    <section aria-label="게임 글 목록">
      <div class="section-head">
        <div><h2>게임</h2></div>
        <div class="section-head__controls">
          <div class="sub-drop" id="guide-sub-drop">
            <button type="button" class="sub-filter" id="guide-sub-trigger" aria-haspopup="listbox" aria-expanded="false">전체</button>
            <div class="sub-dropdown" role="listbox" id="guide-sub-list">
              <button type="button" class="sub-dropdown-item" data-value="" role="option">전체</button>
              {subcats.map((sub) => <button type="button" class="sub-dropdown-item" data-value={sub.name} role="option">{sub.name}</button>)}
            </div>
          </div>
          <input id="guide-search" class="home-search-input" type="search" placeholder="검색" aria-label="게임 검색" autocomplete="off" />
        </div>
      </div>
      <div class="grid" id="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <nav class="pagination" id="post-pagination" aria-label="게임 글 페이지"></nav>
    </section>
    <div class="tool-coupang tool-coupang--sm">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021110,"template":"carousel","trackingCode":"AF7638395","width":"250","height":"250","tsource":""});
</script>
    </div>
    <div class="tool-coupang tool-coupang--lg">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021235,"trackingCode":"AF7638395","subId":null,"template":"carousel","width":"662","height":"140"});
</script>
    </div>
  </main>
  <script>
    const grid = document.getElementById('post-grid') as HTMLElement;
    const allCards = Array.from(grid?.children ?? []) as HTMLElement[];

    function setupSubDrop(drop: HTMLElement, onChange: (value: string) => void) {
      const trigger = drop.querySelector('.sub-filter') as HTMLButtonElement;
      const list = drop.querySelector('.sub-dropdown') as HTMLElement;
      const items = Array.from(drop.querySelectorAll('.sub-dropdown-item')) as HTMLButtonElement[];
      let value = '';
      const clampList = () => {
        const r = list.getBoundingClientRect();
        const vw = document.documentElement.clientWidth;
        const dx = Math.max(8 - r.left, Math.min(0, vw - 8 - r.right));
        if (dx === 0) { list.style.left = ''; return; }
        list.style.left = `${dx}px`;
      };
      const open = () => { list.classList.add('open'); trigger.setAttribute('aria-expanded', 'true'); clampList(); };
      const close = () => { list.classList.remove('open'); trigger.setAttribute('aria-expanded', 'false'); list.style.left = ''; };
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        list.classList.contains('open') ? close() : open();
      });
      items.forEach((item) => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          value = item.dataset.value || '';
          trigger.textContent = item.textContent || '전체';
          items.forEach((it) => it.classList.toggle('active', it === item));
          close();
          onChange(value);
        });
      });
      document.addEventListener('click', (e) => {
        if (!drop.contains(e.target as Node)) close();
      });
      return { getValue: () => value };
    }

    const guideSearch = document.getElementById('guide-search') as HTMLInputElement;
    const pagination = document.getElementById('post-pagination') as HTMLElement;
    const PER_PAGE = 24;
    let currentPage = 1;

    function getFiltered() {
      const q = (guideSearch?.value || '').trim().toLowerCase();
      const sub = guideSub.getValue();
      return allCards.filter((card) => {
        const matchSub = !sub || card.dataset.subcategory === sub;
        const matchQ = !q || card.textContent?.toLowerCase().includes(q);
        return matchSub && matchQ;
      });
    }

    function renderPagination(totalPages: number) {
      pagination.innerHTML = '';
      if (totalPages <= 1) return;
      const makeBtn = (label: string, page: number, opts: { disabled?: boolean; current?: boolean } = {}) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'pagination__btn' + (opts.current ? ' is-current' : '');
        btn.textContent = label;
        if (opts.disabled) btn.disabled = true;
        if (opts.current) btn.setAttribute('aria-current', 'page');
        if (!opts.disabled && !opts.current) btn.addEventListener('click', () => { currentPage = page; render(); });
        return btn;
      };
      pagination.appendChild(makeBtn('이전', currentPage - 1, { disabled: currentPage === 1 }));
      const windowSize = 5;
      let start = Math.max(1, currentPage - 2);
      let end = Math.min(totalPages, start + windowSize - 1);
      start = Math.max(1, end - windowSize + 1);
      for (let p = start; p <= end; p += 1) {
        pagination.appendChild(makeBtn(String(p), p, { current: p === currentPage }));
      }
      pagination.appendChild(makeBtn('다음', currentPage + 1, { disabled: currentPage === totalPages }));
    }

    function render() {
      const filtered = getFiltered();
      const totalPages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
      if (currentPage > totalPages) currentPage = totalPages;
      allCards.forEach((card) => { card.style.display = 'none'; });
      const start = (currentPage - 1) * PER_PAGE;
      filtered.slice(start, start + PER_PAGE).forEach((card) => { card.style.display = ''; });
      renderPagination(totalPages);
    }

    function filterGuides() {
      currentPage = 1;
      render();
    }
    guideSearch?.addEventListener('input', filterGuides);
    const guideSub = setupSubDrop(document.getElementById('guide-sub-drop') as HTMLElement, () => filterGuides());
    render();
  </script>
</BaseLayout>