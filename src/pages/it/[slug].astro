---
import CategoryListPage from '../../components/CategoryListPage.astro';
import { IT_SUBCATEGORIES, type Subcategory } from '../../consts';

export function getStaticPaths() {
  return IT_SUBCATEGORIES.map((sub) => ({
    params: { slug: sub.slug },
    props: { sub }
  }));
}

const { sub } = Astro.props as { sub: Subcategory };
---
<CategoryListPage category="IT" page={1} subcategory={sub.name} subcategorySlug={sub.slug} metaDescription={sub.metaDescription} />
