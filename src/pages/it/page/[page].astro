---
import CategoryListPage from '../../../components/CategoryListPage.astro';
import { getCategoryListPages } from '../../../lib/categoryList';

export function getStaticPaths() {
  const itPages = getCategoryListPages('IT');
  const paths = [];
  for (let page = 2; page <= itPages; page += 1) {
    paths.push({ params: { page: String(page) }, props: { page } });
  }
  return paths;
}

const { page } = Astro.props;
---
<CategoryListPage category="IT" page={page} />