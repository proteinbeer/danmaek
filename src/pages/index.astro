---
import BaseLayout from '../components/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPostsByCategory } from '../lib/posts';
import { GUIDE_SUBCATEGORIES, NEWS_SUBCATEGORIES, COUPON_SUBCATEGORIES } from '../consts';
import { TOOLS } from '../lib/tools';

const posts = getPostsByCategory('뉴스');
const guidePosts = getPostsByCategory('가이드');
const couponPosts = getPostsByCategory('쿠폰');
const newsSubcats = [...NEWS_SUBCATEGORIES];
const guideSubcats = [...GUIDE_SUBCATEGORIES];
const couponSubcats = [...COUPON_SUBCATEGORIES];
---
<BaseLayout>
  <main class="home-page">
    <div class="container adfit-banner">
      <ins class="kakao_ad_area" style="display:none;"
        data-ad-unit="DAN-LoWQpAjT1C8qjOLo"
        data-ad-width="728"
        data-ad-height="90"></ins>
      <script is:inline async type="text/javascript" charset="utf-8" src="https://t1.kakaocdn.net/kas/static/ba.min.js"></script>
    </div>
    <section class="container home-hero" aria-labelledby="home-title">
      <h1 id="home-title">IT, 게임, 도구를 빠르게 깊게</h1>
      <p>새로운 기술과 게임 흐름, 바로 쓰는 온라인 도구를 단맥답게 정리합니다.</p>
    </section>

    <section class="container" aria-labelledby="latest-title" id="all-posts">
      <div class="section-head">
        <div>
          <h2 id="latest-title">단 글</h2>
        </div>
        <div class="section-head__controls">
          <div class="sub-drop" id="news-sub-drop">
            <button type="button" class="sub-filter" id="news-sub-trigger" aria-haspopup="listbox" aria-expanded="false">전체</button>
            <div class="sub-dropdown" role="listbox" id="news-sub-list">
              <button type="button" class="sub-dropdown-item" data-value="" role="option">전체</button>
              {newsSubcats.map((sub) => <button type="button" class="sub-dropdown-item" data-value={sub.name} role="option">{sub.name}</button>)}
            </div>
          </div>
          <input id="home-search" class="home-search-input" type="search" placeholder="검색" aria-label="글 검색" autocomplete="off" />
        </div>
      </div>
      <div class="grid" id="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <nav class="pager" id="pager" aria-label="글 페이지 네비게이션">
        <button type="button" class="pager__arrow" id="pager-prev" aria-label="이전 페이지">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <span class="pager__status" id="pager-status"></span>
        <button type="button" class="pager__arrow" id="pager-next" aria-label="다음 페이지">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </nav>
    </section>

    <section class="container" aria-labelledby="guides-title" id="guide-section">
      <div class="section-head">
        <div>
          <h2 id="guides-title">단 가이드</h2>
        </div>
        <div class="section-head__controls">
          <div class="sub-drop" id="guide-sub-drop">
            <button type="button" class="sub-filter" id="guide-sub-trigger" aria-haspopup="listbox" aria-expanded="false">전체</button>
            <div class="sub-dropdown" role="listbox" id="guide-sub-list">
              <button type="button" class="sub-dropdown-item" data-value="" role="option">전체</button>
              {guideSubcats.map((sub) => <button type="button" class="sub-dropdown-item" data-value={sub.name} role="option">{sub.name}</button>)}
            </div>
          </div>
          <input id="home-guide-search" class="home-search-input" type="search" placeholder="가이드 검색" aria-label="가이드 검색" autocomplete="off" />
        </div>
      </div>
      <div class="grid" id="guide-grid">
        {guidePosts.map((post) => <PostCard post={post} />)}
      </div>
      <nav class="pager" id="guide-pager" aria-label="가이드 페이지 네비게이션">
        <button type="button" class="pager__arrow" id="guide-pager-prev" aria-label="이전 페이지">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <span class="pager__status" id="guide-pager-status"></span>
        <button type="button" class="pager__arrow" id="guide-pager-next" aria-label="다음 페이지">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </nav>
    </section>

    <section class="container" aria-labelledby="coupons-title" id="coupon-section">
      <div class="section-head">
        <div>
          <h2 id="coupons-title">단 쿠폰</h2>
        </div>
        <div class="section-head__controls">
          <div class="sub-drop" id="coupon-sub-drop">
            <button type="button" class="sub-filter" id="coupon-sub-trigger" aria-haspopup="listbox" aria-expanded="false">전체</button>
            <div class="sub-dropdown" role="listbox" id="coupon-sub-list">
              <button type="button" class="sub-dropdown-item" data-value="" role="option">전체</button>
              {couponSubcats.map((sub) => <button type="button" class="sub-dropdown-item" data-value={sub.name} role="option">{sub.name}</button>)}
            </div>
          </div>
          <input id="home-coupon-search" class="home-search-input" type="search" placeholder="쿠폰 검색" aria-label="쿠폰 검색" autocomplete="off" />
        </div>
      </div>
      <div class="grid" id="coupon-grid">
        {couponPosts.map((post) => <PostCard post={post} />)}
      </div>
      <nav class="pager" id="coupon-pager" aria-label="쿠폰 페이지 네비게이션">
        <button type="button" class="pager__arrow" id="coupon-pager-prev" aria-label="이전 페이지">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <span class="pager__status" id="coupon-pager-status"></span>
        <button type="button" class="pager__arrow" id="coupon-pager-next" aria-label="다음 페이지">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </nav>
    </section>

    <section class="container" aria-labelledby="tools-title" id="tool-section">
      <div class="section-head">
        <div>
          <h2 id="tools-title">단 도구</h2>
        </div>
        <input id="home-tool-search" class="home-search-input" type="search" placeholder="도구 검색" aria-label="도구 검색" autocomplete="off" />
      </div>
      <div class="tool-grid" id="tool-grid">
        {[...TOOLS].reverse().map((tool) => (
          <a class="tool-card" href={`/tools/${tool.slug}/`}>
            <i aria-hidden="true">{tool.icon}</i>
            <span>{tool.category}</span>
            <strong>{tool.title}</strong>
            <p>{tool.description}</p>
          </a>
        ))}
      </div>
      <nav class="pager" id="tool-pager" aria-label="툴 페이지 네비게이션">
        <button type="button" class="pager__arrow" id="tool-pager-prev" aria-label="이전 툴 페이지">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <span class="pager__status" id="tool-pager-status"></span>
        <button type="button" class="pager__arrow" id="tool-pager-next" aria-label="다음 툴 페이지">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </nav>
      <div class="tool-coupang tool-coupang--sm">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021110,"template":"carousel","trackingCode":"AF7638395","width":"250","height":"250","tsource":""});
</script>
      </div>
      <div class="tool-coupang tool-coupang--lg">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021235,"trackingCode":"AF7638395","subId":null,"template":"carousel","width":"662","height":"140"});
</script>
      </div>
    </section>

  </main>
  <script>
    const PAGE_SIZE = 6;
    const grid = document.getElementById('post-grid') as HTMLElement;
    const pager = document.getElementById('pager') as HTMLElement;
    const prevButton = document.getElementById('pager-prev') as HTMLButtonElement;
    const nextButton = document.getElementById('pager-next') as HTMLButtonElement;
    const status = document.getElementById('pager-status') as HTMLElement;
    const allCards = Array.from(grid?.children ?? []) as HTMLElement[];
    let filteredCards = [...allCards];
    let postTotalPages = Math.ceil(filteredCards.length / PAGE_SIZE);
    let current = 0;

    function makePlaceholder() {
      const div = document.createElement('div');
      div.className = 'post-card post-card--placeholder';
      div.setAttribute('aria-hidden', 'true');
      div.innerHTML = '<div class="post-card__image"><img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" width="640" height="360" /></div><div class="post-card__meta"><a>&nbsp;</a><span>&nbsp;</span><time>&nbsp;</time></div><h3><a>&nbsp;<br>&nbsp;</a></h3>';
      return div;
    }

    function renderPosts() {
      const start = current * PAGE_SIZE;
      const pageCards = filteredCards.slice(start, start + PAGE_SIZE);
      grid.innerHTML = '';
      pageCards.forEach((card) => { card.style.display = ''; grid.appendChild(card); });
      for (let i = pageCards.length; i < PAGE_SIZE; i++) grid.appendChild(makePlaceholder());
      status.textContent = `${current + 1} / ${postTotalPages}`;
      prevButton.disabled = current === 0;
      nextButton.disabled = current >= postTotalPages - 1;
      pager.hidden = postTotalPages <= 1 && filteredCards.length <= PAGE_SIZE;
    }

    function goTo(page: number) {
      if (page < 0 || page > postTotalPages - 1 || page === current) return;
      current = page;
      renderPosts();
    }

    prevButton?.addEventListener('click', () => goTo(current - 1));
    nextButton?.addEventListener('click', () => goTo(current + 1));

    const TOOL_PAGE_SIZE = 6;
    const toolGrid = document.getElementById('tool-grid') as HTMLElement;
    const toolPager = document.getElementById('tool-pager') as HTMLElement;
    const toolPrevButton = document.getElementById('tool-pager-prev') as HTMLButtonElement;
    const toolNextButton = document.getElementById('tool-pager-next') as HTMLButtonElement;
    const toolStatus = document.getElementById('tool-pager-status') as HTMLElement;
    const allToolCards = Array.from(toolGrid?.children ?? []) as HTMLElement[];
    let filteredToolCards = [...allToolCards];
    let toolTotalPages = Math.ceil(filteredToolCards.length / TOOL_PAGE_SIZE);
    let toolCurrent = 0;

    function makeToolPlaceholder() {
      const div = document.createElement('div');
      div.className = 'tool-card tool-card--placeholder';
      div.setAttribute('aria-hidden', 'true');
      div.innerHTML = '<i aria-hidden="true">&nbsp;</i><span>&nbsp;</span><strong>&nbsp;</strong><p>&nbsp;</p>';
      return div;
    }

    function renderTools() {
      const start = toolCurrent * TOOL_PAGE_SIZE;
      const pageCards = filteredToolCards.slice(start, start + TOOL_PAGE_SIZE);
      toolGrid.innerHTML = '';
      pageCards.forEach((card) => { card.style.display = ''; toolGrid.appendChild(card); });
      for (let i = pageCards.length; i < TOOL_PAGE_SIZE; i++) toolGrid.appendChild(makeToolPlaceholder());
      toolStatus.textContent = `${toolCurrent + 1} / ${toolTotalPages}`;
      toolPrevButton.disabled = toolCurrent === 0;
      toolNextButton.disabled = toolCurrent >= toolTotalPages - 1;
      toolPager.hidden = toolTotalPages <= 1 && filteredToolCards.length <= TOOL_PAGE_SIZE;
    }

    function goToToolPage(page: number) {
      if (page < 0 || page > toolTotalPages - 1 || page === toolCurrent) return;
      toolCurrent = page;
      renderTools();
    }

    toolPrevButton?.addEventListener('click', () => goToToolPage(toolCurrent - 1));
    toolNextButton?.addEventListener('click', () => goToToolPage(toolCurrent + 1));

    const homeSearch = document.getElementById('home-search') as HTMLInputElement;
    const homeToolSearch = document.getElementById('home-tool-search') as HTMLInputElement;
    const newsSubDrop = document.getElementById('news-sub-drop') as HTMLElement;
    const newsSubTrigger = document.getElementById('news-sub-trigger') as HTMLButtonElement;

    function setupSubDrop(drop: HTMLElement, onChange: (value: string) => void) {
      const trigger = drop.querySelector('.sub-filter') as HTMLButtonElement;
      const list = drop.querySelector('.sub-dropdown') as HTMLElement;
      const items = Array.from(drop.querySelectorAll('.sub-dropdown-item')) as HTMLButtonElement[];
      let value = '';
      const open = () => { list.classList.add('open'); trigger.setAttribute('aria-expanded', 'true'); };
      const close = () => { list.classList.remove('open'); trigger.setAttribute('aria-expanded', 'false'); };
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        list.classList.contains('open') ? close() : open();
      });
      items.forEach((item) => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          value = item.dataset.value || '';
          trigger.textContent = item.textContent || '전체';
          items.forEach((it) => it.classList.toggle('active', it === item));
          close();
          onChange(value);
        });
      });
      document.addEventListener('click', (e) => {
        if (!drop.contains(e.target as Node)) close();
      });
      return { close, getValue: () => value };
    }

    const newsSub = setupSubDrop(newsSubDrop, () => filterPosts());

    function filterPosts() {
      const q = (homeSearch?.value || '').trim().toLowerCase();
      const sub = newsSub.getValue();
      filteredCards = allCards.filter((card) => {
        if (sub && card.dataset.subcategory !== sub) return false;
        if (q && !card.textContent?.toLowerCase().includes(q)) return false;
        return true;
      });
      postTotalPages = Math.ceil(filteredCards.length / PAGE_SIZE) || 1;
      current = 0;
      renderPosts();
    }

    function filterTools() {
      const q = (homeToolSearch?.value || '').trim().toLowerCase();
      if (q) {
        filteredToolCards = allToolCards.filter((card) => card.textContent?.toLowerCase().includes(q));
      } else {
        filteredToolCards = [...allToolCards];
      }
      toolTotalPages = Math.ceil(filteredToolCards.length / TOOL_PAGE_SIZE) || 1;
      toolCurrent = 0;
      renderTools();
    }

    homeSearch?.addEventListener('input', filterPosts);
    homeToolSearch?.addEventListener('input', filterTools);

    const guideSearch = document.getElementById('home-guide-search') as HTMLInputElement;
    const guideSubDrop = document.getElementById('guide-sub-drop') as HTMLElement;
    const guideGrid = document.getElementById('guide-grid') as HTMLElement;
    const guidePager = document.getElementById('guide-pager') as HTMLElement;
    const guidePrevButton = document.getElementById('guide-pager-prev') as HTMLButtonElement;
    const guideNextButton = document.getElementById('guide-pager-next') as HTMLButtonElement;
    const guideStatus = document.getElementById('guide-pager-status') as HTMLElement;
    const GUIDE_PAGE_SIZE = 6;
    const allGuideCards = Array.from(guideGrid?.children ?? []) as HTMLElement[];
    let filteredGuideCards = [...allGuideCards];
    let guideTotalPages = Math.ceil(filteredGuideCards.length / GUIDE_PAGE_SIZE);
    let guideCurrent = 0;

    function renderGuides() {
      const start = guideCurrent * GUIDE_PAGE_SIZE;
      const pageCards = filteredGuideCards.slice(start, start + GUIDE_PAGE_SIZE);
      guideGrid.innerHTML = '';
      pageCards.forEach((card) => { card.style.display = ''; guideGrid.appendChild(card); });
      for (let i = pageCards.length; i < GUIDE_PAGE_SIZE; i++) guideGrid.appendChild(makePlaceholder());
      guideStatus.textContent = `${guideCurrent + 1} / ${guideTotalPages}`;
      guidePrevButton.disabled = guideCurrent === 0;
      guideNextButton.disabled = guideCurrent >= guideTotalPages - 1;
      guidePager.hidden = guideTotalPages <= 1 && filteredGuideCards.length <= GUIDE_PAGE_SIZE;
    }

    function goToGuidePage(page: number) {
      if (page < 0 || page > guideTotalPages - 1 || page === guideCurrent) return;
      guideCurrent = page;
      renderGuides();
    }

    function filterGuides() {
      const q = (guideSearch?.value || '').trim().toLowerCase();
      const sub = guideSub.getValue();
      filteredGuideCards = allGuideCards.filter((card) => {
        if (sub && card.dataset.subcategory !== sub) return false;
        if (q && !card.textContent?.toLowerCase().includes(q)) return false;
        return true;
      });
      guideTotalPages = Math.ceil(filteredGuideCards.length / GUIDE_PAGE_SIZE) || 1;
      guideCurrent = 0;
      renderGuides();
    }

    guidePrevButton?.addEventListener('click', () => goToGuidePage(guideCurrent - 1));
    guideNextButton?.addEventListener('click', () => goToGuidePage(guideCurrent + 1));
    guideSearch?.addEventListener('input', filterGuides);
    const guideSub = setupSubDrop(guideSubDrop, () => filterGuides());

    const couponGrid = document.getElementById('coupon-grid') as HTMLElement;
    const couponSearch = document.getElementById('home-coupon-search') as HTMLInputElement;
    const couponPager = document.getElementById('coupon-pager') as HTMLElement;
    const couponPrevButton = document.getElementById('coupon-pager-prev') as HTMLButtonElement;
    const couponNextButton = document.getElementById('coupon-pager-next') as HTMLButtonElement;
    const couponStatus = document.getElementById('coupon-pager-status') as HTMLElement;
    const COUPON_PAGE_SIZE = 6;
    const allCouponCards = Array.from(couponGrid?.children ?? []) as HTMLElement[];
    let filteredCouponCards = [...allCouponCards];
    let couponTotalPages = Math.ceil(filteredCouponCards.length / COUPON_PAGE_SIZE);
    let couponCurrent = 0;
    function renderCoupons() {
      const start = couponCurrent * COUPON_PAGE_SIZE;
      const pageCards = filteredCouponCards.slice(start, start + COUPON_PAGE_SIZE);
      couponGrid.innerHTML = '';
      pageCards.forEach((card) => { card.style.display = ''; couponGrid.appendChild(card); });
      for (let i = pageCards.length; i < COUPON_PAGE_SIZE; i++) couponGrid.appendChild(makePlaceholder());
      couponStatus.textContent = `${couponCurrent + 1} / ${couponTotalPages}`;
      couponPrevButton.disabled = couponCurrent === 0;
      couponNextButton.disabled = couponCurrent >= couponTotalPages - 1;
      couponPager.hidden = couponTotalPages <= 1 && filteredCouponCards.length <= COUPON_PAGE_SIZE;
    }
    function goToCouponPage(page: number) {
      if (page < 0 || page > couponTotalPages - 1 || page === couponCurrent) return;
      couponCurrent = page;
      renderCoupons();
    }
    function filterCoupons() {
      const q = (couponSearch?.value || '').trim().toLowerCase();
      const sub = couponSub.getValue();
      filteredCouponCards = allCouponCards.filter((card) => {
        if (sub && card.dataset.subcategory !== sub) return false;
        if (q && !card.textContent?.toLowerCase().includes(q)) return false;
        return true;
      });
      couponTotalPages = Math.ceil(filteredCouponCards.length / COUPON_PAGE_SIZE) || 1;
      couponCurrent = 0;
      renderCoupons();
    }
    couponPrevButton?.addEventListener('click', () => goToCouponPage(couponCurrent - 1));
    couponNextButton?.addEventListener('click', () => goToCouponPage(couponCurrent + 1));
    couponSearch?.addEventListener('input', filterCoupons);
    const couponSub = setupSubDrop(document.getElementById('coupon-sub-drop') as HTMLElement, () => filterCoupons());

    renderPosts();
    renderTools();
    renderGuides();
    renderCoupons();
  </script>
</BaseLayout>
