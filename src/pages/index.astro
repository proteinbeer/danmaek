---
import BaseLayout from '../components/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPostsByCategory } from '../lib/posts';

const HOME_COUNT = 9;
const itPosts = getPostsByCategory('IT');
const gamePosts = getPostsByCategory('게임');
const byDateDesc = (a: { data: { date: Date } }, b: { data: { date: Date } }) => b.data.date.getTime() - a.data.date.getTime();
const sortedItPosts = [...itPosts].sort(byDateDesc).slice(0, HOME_COUNT);
const sortedGamePosts = [...gamePosts].sort(byDateDesc).slice(0, HOME_COUNT);
---
<BaseLayout
  title="단맥 | IT·게임 가이드"
  description="PC, 윈도우, 네트워크, 하드웨어 문제 해결법과 게임 공략·설정·최적화 가이드를 정리합니다."
>
  <main class="home-page">
    <div class="container adfit-banner">
      <ins class="kakao_ad_area" style="display:none;"
        data-ad-unit="DAN-LoWQpAjT1C8qjOLo"
        data-ad-width="728"
        data-ad-height="90"></ins>
      <script is:inline async type="text/javascript" charset="utf-8" src="https://t1.kakaocdn.net/kas/static/ba.min.js"></script>
    </div>
    <section class="container" aria-labelledby="latest-title">
      <div class="section-head">
        <div>
          <h2 id="latest-title">단 IT</h2>
          <p class="section-desc">PC, Windows, 네트워크와 하드웨어 문제를 해결하는 가이드</p>
        </div>
      </div>
      <div class="grid">
        {sortedItPosts.map((post) => <PostCard post={post} />)}
      </div>
      <p class="home-more">
        <a class="button-link" href="/it/">단 IT 더 보기</a>
      </p>
    </section>

    <section class="container" aria-labelledby="guides-title">
      <div class="section-head">
        <div>
          <h2 id="guides-title">단 게임</h2>
          <p class="section-desc">게임 공략, 설정, 최적화와 플랫폼별 문제 해결 가이드</p>
        </div>
      </div>
      <div class="grid">
        {sortedGamePosts.map((post) => <PostCard post={post} />)}
      </div>
      <p class="home-more">
        <a class="button-link" href="/games/">단 게임 더 보기</a>
      </p>
    </section>

    <div class="tool-coupang tool-coupang--sm">
<p class="affiliate-note">본문의 일부 상품 링크는 쿠팡 파트너스 활동의 일환으로 수수료를 받을 수 있습니다.</p>
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021110,"template":"carousel","trackingCode":"AF7638395","width":"250","height":"250","tsource":""});
</script>
    </div>
    <div class="tool-coupang tool-coupang--lg">
<p class="affiliate-note">본문의 일부 상품 링크는 쿠팡 파트너스 활동의 일환으로 수수료를 받을 수 있습니다.</p>
<script is:inline>
	new PartnersCoupang.G({"id":1021235,"trackingCode":"AF7638395","subId":null,"template":"carousel","width":"662","height":"140"});
</script>
    </div>

  </main>
</BaseLayout>