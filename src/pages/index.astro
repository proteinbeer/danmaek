---
import BaseLayout from '../components/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPostsByCategory } from '../lib/posts';

const itPosts = getPostsByCategory('IT');
const gamePosts = getPostsByCategory('게임');
const byDateDesc = (a: { data: { date: Date } }, b: { data: { date: Date } }) => b.data.date.getTime() - a.data.date.getTime();
const recentItPosts = [...itPosts].sort(byDateDesc).slice(0, 6);
const capPerGame = (posts: { data: { subcategory: string; date: Date } }[], maxPerGame: number) => {
  const counts = new Map<string, number>();
  const result: { data: { subcategory: string; date: Date } }[] = [];
  for (const post of [...posts].sort(byDateDesc)) {
    const key = post.data.subcategory || '기타';
    const seen = counts.get(key) ?? 0;
    if (seen >= maxPerGame) continue;
    counts.set(key, seen + 1);
    result.push(post);
  }
  return result;
};
const recentGamePosts = capPerGame(gamePosts, 4).slice(0, 6);
---
<BaseLayout>
  <main class="home-page">
    <div class="container adfit-banner">
      <ins class="kakao_ad_area" style="display:none;"
        data-ad-unit="DAN-LoWQpAjT1C8qjOLo"
        data-ad-width="728"
        data-ad-height="90"></ins>
      <script is:inline async type="text/javascript" charset="utf-8" src="https://t1.kakaocdn.net/kas/static/ba.min.js"></script>
    </div>
    <section class="container" aria-labelledby="latest-title" id="all-posts">
      <div class="section-head">
        <div>
          <h2 id="latest-title">단 IT</h2>
        </div>
      </div>
      <div class="grid js-page-grid" id="post-grid">
        {recentItPosts.map((post) => <PostCard post={post} />)}
      </div>
      <p class="home-more">
        <a class="button-link" href="/it/">IT 전체 보기</a>
      </p>
    </section>

    <section class="container" aria-labelledby="guides-title" id="guide-section">
      <div class="section-head">
        <div>
          <h2 id="guides-title">단 게임</h2>
        </div>
      </div>
      <div class="grid js-page-grid" id="guide-grid">
        {recentGamePosts.map((post) => <PostCard post={post} />)}
      </div>
      <p class="home-more">
        <a class="button-link" href="/games/">게임 전체 보기</a>
      </p>
    </section>

    <div class="tool-coupang tool-coupang--sm">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021110,"template":"carousel","trackingCode":"AF7638395","width":"250","height":"250","tsource":""});
</script>
    </div>
    <div class="tool-coupang tool-coupang--lg">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021235,"trackingCode":"AF7638395","subId":null,"template":"carousel","width":"662","height":"140"});
</script>
    </div>

  </main>
</BaseLayout>