---
import BaseLayout from '../components/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { getPostsByCategory } from '../lib/posts';

const HOME_COUNT = 6;
const itPosts = getPostsByCategory('IT').slice(0, HOME_COUNT);
---
<BaseLayout
  title={`${SITE.name} | IT 경험 기록`}
  description="PC와 프로그램을 직접 사용하면서 겪은 문제와 해결 과정을 기록하는 IT 블로그입니다."
>
  <main class="home-page">
    <section class="container home-intro" aria-labelledby="home-title">
      <p class="eyebrow">DANMAEK</p>
      <h1 id="home-title">PC와 프로그램을 쓰며 겪은 문제를 기록합니다</h1>
      <p>
        단맥은 일반 정보를 다시 모으기보다 실제로 사용하다가 막혔던 부분,
        직접 확인한 설정, 해결 과정과 결과를 중심으로 정리합니다.
      </p>
    </section>

    <section class="container" aria-labelledby="latest-title">
      <div class="section-head">
        <div>
          <h2 id="latest-title">IT</h2>
          <p class="section-desc">직접 겪은 PC와 프로그램 문제 해결 기록</p>
        </div>
      </div>
      <div class="grid">
        {itPosts.map((post) => <PostCard post={post} />)}
      </div>
      <p class="home-more">
        <a class="button-link" href="/it/">IT 글 보기</a>
      </p>
    </section>
  </main>
</BaseLayout>
