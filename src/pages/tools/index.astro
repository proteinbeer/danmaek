---
import BaseLayout from '../../components/BaseLayout.astro';
import { CATEGORIES, SITE } from '../../consts';
import { TOOLS } from '../../lib/tools';

const category = CATEGORIES.find((item) => item.name === '도구')!;
---
<BaseLayout title={`도구 | ${SITE.name}`} description={category.description} canonical={new URL('/tools/', SITE.url).toString()}>
  <main class="container">
    <div class="adfit-banner">
      <ins class="kakao_ad_area" style="display:none;"
        data-ad-unit="DAN-LoWQpAjT1C8qjOLo"
        data-ad-width="728"
        data-ad-height="90"></ins>
      <script is:inline async type="text/javascript" charset="utf-8" src="https://t1.kakaocdn.net/kas/static/ba.min.js"></script>
    </div>
    <section aria-label="도구 목록">
      <div class="section-head">
        <div><h2>도구</h2></div>
        <div class="section-head__controls">
          <input id="tools-search" class="home-search-input" type="search" placeholder="도구 검색" aria-label="도구 검색" autocomplete="off" />
        </div>
      </div>
      <div class="grid" id="tool-grid">
        {[...TOOLS].reverse().map((tool) => (
          <article class="post-card" data-search={`${tool.title} ${tool.category}`}>
            <a class="post-card__image" href={`/tools/${tool.slug}/`} aria-label={tool.title}>
              <div class="tool-card__icon-placeholder">{tool.icon}</div>
            </a>
            <div class="post-card__meta">
              <span>{tool.category}</span>
            </div>
            <h3><a href={`/tools/${tool.slug}/`}>{tool.title}</a></h3>
          </article>
        ))}
      </div>
    </section>
    <div class="tool-coupang tool-coupang--sm">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021110,"template":"carousel","trackingCode":"AF7638395","width":"250","height":"250","tsource":""});
</script>
    </div>
    <div class="tool-coupang tool-coupang--lg">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021235,"trackingCode":"AF7638395","subId":null,"template":"carousel","width":"662","height":"140"});
</script>
    </div>
  </main>
  <script>
    const toolGrid = document.getElementById('tool-grid') as HTMLElement;
    const allToolCards = Array.from(toolGrid?.children ?? []) as HTMLElement[];
    const toolsSearch = document.getElementById('tools-search') as HTMLInputElement;
    function filterTools() {
      const q = (toolsSearch?.value || '').trim().toLowerCase();
      allToolCards.forEach((card) => {
        card.style.display = !q || card.dataset.search?.toLowerCase().includes(q) ? '' : 'none';
      });
    }
    toolsSearch?.addEventListener('input', filterTools);
  </script>
</BaseLayout>
