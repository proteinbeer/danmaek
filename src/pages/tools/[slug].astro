        const today = new Date();
        let age = today.getFullYear() - birth.getFullYear();
        const passed = today.getMonth() > birth.getMonth() || (today.getMonth() === birth.getMonth() && today.getDate() >= birth.getDate());
        if (!passed) age -= 1;
        show(`현재 만 나이는 ${age}세입니다.`);
