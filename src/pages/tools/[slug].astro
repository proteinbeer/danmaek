---

import BaseLayout from '../../components/BaseLayout.astro';
import { TOOLS } from '../../lib/tools';

export function getStaticPaths() {
  return TOOLS.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://danmaek.com').toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": tool.title,
  "description": tool.description,
  "url": canonicalUrl,
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "KRW" }
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "홈", "item": "https://danmaek.com/" },
    { "@type": "ListItem", "position": 2, "name": "도구", "item": "https://danmaek.com/tools/" },
    { "@type": "ListItem", "position": 3, "name": tool.title }
  ]
};
---

<BaseLayout title={`${tool.title} | 단맥`} description={tool.description} canonical={canonicalUrl}>
  <link slot="head" rel="stylesheet" href="/assets/tailwind.css" />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <main class="tool-page">
    <section class="container tool-wrap">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">홈</a> <span aria-hidden="true">/</span> <a href="/tools/">도구</a>
      </nav>
      <article class="tool-panel tool-panel--sft" data-tool={tool.type} data-slug={tool.slug} data-icon={tool.icon} data-title={tool.title} data-description={tool.description}>
        <div class="tool-panel__icon" aria-hidden="true">{tool.icon}</div>
        <p class="eyebrow">{tool.category}</p>
        <h1>{tool.title}</h1>
        <p class="tool-desc">{tool.description}</p>

        <div class="tool-form tool-form--sft" data-form>
          <p class="tool-loading">도구를 불러오는 중입니다.</p>
        </div>
        <div class="tool-result" data-result hidden></div>
      </article>
      <div id="tool-feedback" class="tool-feedback">
        <p class="tool-feedback__title">이 도구가 마음에 드셨나요?</p>
        <div class="tool-feedback__buttons">
          <button type="button" id="feedbackLike" class="tool-feedback__btn" data-vote="like">👍 좋아요</button>
          <button type="button" id="feedbackDislike" class="tool-feedback__btn" data-vote="dislike">👎 별로예요</button>
        </div>
        <div id="feedbackFormWrap" class="tool-feedback__form hidden">
          <textarea id="feedbackMessage" rows="2" class="tool-feedback__textarea" placeholder="개선 의견을 적어 주세요" required></textarea>
          <button type="button" id="feedbackSubmit" class="tool-feedback__submit">보내기</button>
        </div>
      </div>
      <div class="tool-coupang tool-coupang--sm">
<!-- COUPANG PARTNERS DYNAMIC BANNER START -->
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	// @ts-ignore - PartnersCoupang is defined by external Coupang script
	new PartnersCoupang.G({"id":1021110,"template":"carousel","trackingCode":"AF7638395","width":"250","height":"250","tsource":""});
</script>
<!-- COUPANG PARTNERS DYNAMIC BANNER END -->
      </div>
      <div class="tool-coupang tool-coupang--lg">
<!-- COUPANG PARTNERS DYNAMIC BANNER START -->
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
