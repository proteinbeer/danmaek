    function number(id: string) {
      const raw = (document.getElementById(id) as HTMLInputElement | null)?.value || '';
      return Number(raw.replace(/,/g, ''));
    }
    function formatNumberInput(input: HTMLInputElement, allowDecimal: boolean) {
      const caret = input.selectionStart ?? 0;
      const sanitized = input.value.replace(/,/g, '');
      let formatted: string;
      if (allowDecimal) {
        const digits = sanitized.replace(/[^0-9.]/g, '');
        const [intPart = '', ...rest] = digits.split('.');
        const decimals = rest.join('').slice(0, 2);
        formatted = (intPart.replace(/^0+(?=\d)/, '') || '0').replace(/\B(?=(\d{3})+(?!\d))/g, ',') + (decimals ? '.' + decimals : '');
      } else {
        const digits = sanitized.replace(/[^0-9]/g, '').replace(/^0+(?=\d)/, '');
        formatted = digits.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }
      input.value = formatted;
      input.setSelectionRange(Math.min(caret, input.value.length), Math.min(caret, input.value.length));
    }
    function money(value: number) {
      return Math.round(value).toLocaleString('ko-KR') + '원';
    }
    function fmt(value: number, digits = 4) {
      return Number.isFinite(value) ? Number(value.toFixed(digits)).toLocaleString('ko-KR') : '0';
    }
    function normalCdf(z: number) {
      if (z < -8.2) return 0;
      if (z > 8.2) return 1;
      const sign = z < 0 ? -1 : 1;
      const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741, a4 = -1.453152027, a5 = 1.061405429;
      const p = 0.3275911;
      const x = Math.abs(z) / Math.sqrt(2);
      const t = 1 / (1 + p * x);
      const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
      return 0.5 * (1 + sign * y);
    }
    function lines(id: string) {
      return ((document.getElementById(id) as HTMLTextAreaElement | null)?.value || '').split(/\n+/).map((item) => item.trim()).filter(Boolean);
    }
    function pick<T>(items: T[]) {
      return items[Math.floor(Math.random() * items.length)];
    }
    function show(text: string) {
      if (!result) return;
      result.textContent = text;
      result.hidden = !text;
    }
    function showHtml(html: string) {
      if (!result) return;
      result.innerHTML = html;
      result.hidden = !html;
    }
    function file() {
      return (document.getElementById('file') as HTMLInputElement | null)?.files?.[0] || null;
    }
    function downloadBlob(blob: Blob, filename: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1200);
    }
    function loadImage(srcFile: File) {
      return new Promise<HTMLImageElement>((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = URL.createObjectURL(srcFile);
      });
    }
    function canvasToBlob(canvas: HTMLCanvasElement, type = 'image/png', quality = .9) {
      return new Promise<Blob>((resolve, reject) => {
        canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('이미지 변환 실패')), type, quality);
      });
    }
    function drawImage(img: HTMLImageElement, width = img.naturalWidth, rotate = false, fill = '') {
      const ratio = img.naturalHeight / img.naturalWidth;
      const height = Math.max(1, Math.round(width * ratio));
      const canvas = document.createElement('canvas');
      canvas.width = rotate ? height : width;
      canvas.height = rotate ? width : height;
      const ctx = canvas.getContext('2d')!;
      if (fill) {
        ctx.fillStyle = fill;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }
      if (rotate) {
        ctx.translate(canvas.width, 0);
        ctx.rotate(Math.PI / 2);
        ctx.drawImage(img, 0, 0, width, height);
      } else {
        ctx.drawImage(img, 0, 0, width, height);
      }
      return canvas;
    }
    function outName(srcFile: File, suffix: string, ext: string) {
