          show('JSON 문법 오류가 있습니다.');
          return;
        }
        const pretty = JSON.stringify(parsed, null, spacing);
        const minified = JSON.stringify(parsed);
        const totalValue = document.getElementById('jsonValue');
        const breakdownValue = document.getElementById('jsonBreakdownValue');
        if (totalValue) totalValue.textContent = `유효한 JSON · 정렬 ${pretty.length}자`;
        if (breakdownValue) breakdownValue.textContent = `${pretty.slice(0, 160)}${pretty.length > 160 ? ' …' : ''} (축소 ${minified.length}자)`;
        show(`문법 오류 없음 · 정렬 ${pretty.length}자 · 축소 ${minified.length}자`);
      }
      if (type === 'anniversary') {
        const raw = (document.getElementById('baseDate') as HTMLInputElement | null)?.value;
        const every = Math.max(1, Math.trunc(number('countValue') || 100));
        if (!raw) return show('');
        const base = new Date(raw + 'T00:00:00');
        if (Number.isNaN(base.valueOf())) return show('');
        const now = new Date();
        now.setHours(0, 0, 0, 0);
        const daysPassed = Math.floor((now.getTime() - base.getTime()) / 86400000);
        if (daysPassed < 0) {
          show('기준일이 아직 오지 않았습니다.');
          return;
        }
        const progressed = Math.floor(daysPassed / every);
        const daysUntilNext = (progressed + 1) * every - daysPassed;
        const nextName = `${(progressed + 1) * every}일`;
        const nextDate = new Date(base.getTime() + (progressed + 1) * every * 86400000);
        const totalValue = document.getElementById('anniversaryValue');
        const breakdownValue = document.getElementById('anniversaryBreakdownValue');
        if (totalValue) totalValue.textContent = `${daysPassed}일차`;
        if (breakdownValue) breakdownValue.textContent = `다음 ${nextName} D-${daysUntilNext} (${nextDate.toLocaleDateString('ko-KR')})`;
        show(`오늘 ${daysPassed}일차 · 다음 ${nextName}까지 ${daysUntilNext}일 남았습니다.`);
      }
      if (type === 'lang-switch') {
        const text = (document.getElementById('switchText') as HTMLTextAreaElement | null)?.value || '';
        const dir = (document.getElementById('switchDir') as HTMLSelectElement | null)?.value || 'en2ko';
        if (!text) return show('');
        const out = dir === 'en2ko' ? enToKo(text) : koToEn(text);
        const totalValue = document.getElementById('langSwitchValue');
        const breakdownValue = document.getElementById('langSwitchBreakdownValue');
        if (totalValue) totalValue.textContent = out;
        if (breakdownValue) breakdownValue.textContent = `${text.length}자 → ${out.length}자 (${dir === 'en2ko' ? '영키→한글' : '한글→영키'})`;
        const escaped = out.replace(/[<>&]/g, (m) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[m] || m));
        show(escaped.length > 400 ? escaped.slice(0, 400) + '…' : escaped);
      }
      if (type === 'measure') {
        const amountValue = number('amount');
        const from = (document.getElementById('fromUnit') as HTMLSelectElement | null)?.value || 'ss';
        const density = Number((document.getElementById('ingredient') as HTMLSelectElement | null)?.value || 1);
        if (!amountValue) return show('');
        const mlMap: Record<string, number> = { ss: 15, ts: 5, cup: 200, ml: 1 };
        const ml = amountValue * (mlMap[from] ?? 15);
        const grams = ml * density;
        const p1 = (v: number) => Number(v.toFixed(1)).toLocaleString('ko-KR');
        const totalValue = document.getElementById('measureValue');
        const breakdownValue = document.getElementById('measureBreakdownValue');
        if (totalValue) totalValue.textContent = `${p1(grams)}g`;
        if (breakdownValue) breakdownValue.textContent = `${p1(ml)}ml · 큰술 ${p1(ml / 15)} · 작은술 ${p1(ml / 5)} · 컵 ${p1(ml / 200)}`;
        show(`${p1(grams)}g (${from === 'ml' ? p1(ml) + 'ml' : mlMap[from] + 'ml 기준'})`);
      }
      if (type === 'car-tax') {
        const price = number('carPrice');
        const rate = Number((document.getElementById('carClass') as HTMLSelectElement | null)?.value || 7);
        const big = (document.getElementById('carBig') as HTMLSelectElement | null)?.value === '1';
        if (!price || price <= 0) return show('');
        const acq = price * (rate / 100);
        const edu = big ? acq * 0.3 : 0;
        const total = acq + edu;
        const totalValue = document.getElementById('carTaxValue');
        const breakdownValue = document.getElementById('carTaxBreakdownValue');
        if (totalValue) totalValue.textContent = money(total) + ' 원';
        if (breakdownValue) breakdownValue.textContent = `취득세 ${money(acq)} (${rate}%) · 지방교육세 ${money(edu)}`;
        show(`취득세 ${money(acq)} · 교육세 ${money(edu)} · 총 ${money(total)}`);
      }
      if (type === 'text-base64') {
        const text = (document.getElementById('b64Text') as HTMLTextAreaElement | null)?.value || '';
        const dir = (document.getElementById('b64Dir') as HTMLSelectElement | null)?.value || 'encode';
        if (!text) return show('');
        const isEncode = dir === 'encode';
        let out: string;
        try {
          if (isEncode) out = btoa(unescape(encodeURIComponent(text)));
          else out = decodeURIComponent(escape(atob(text.trim())));
        } catch {
          show('변환에 실패했습니다. 입력값을 확인해야 합니다.');
          return;
        }
        const arrow = document.getElementById('b64Arrow');
        const fromLabel = document.getElementById('b64FromLabel');
        const toLabel = document.getElementById('b64ToLabel');
        if (arrow) arrow.textContent = isEncode ? '›' : '‹';
        if (fromLabel) fromLabel.textContent = isEncode ? '텍스트' : 'Base64';
        if (toLabel) toLabel.textContent = isEncode ? 'Base64' : '텍스트';
        const totalValue = document.getElementById('textBase64Value');
        const breakdownValue = document.getElementById('textBase64BreakdownValue');
        if (totalValue) totalValue.textContent = out;
        if (breakdownValue) breakdownValue.textContent = `${isEncode ? '텍스트→Base64' : 'Base64→텍스트'} · ${isEncode ? `UTF-8 ${new Blob([text]).size.toLocaleString('ko-KR')}바이트` : `Base64 ${text.trim().length.toLocaleString('ko-KR')}자`}`;
        const escaped = out.replace(/[<>&]/g, (m) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[m] || m));
        show(escaped.length > 400 ? escaped.slice(0, 400) + '…' : escaped);
      }
      if (type === 'gacha-cost') {
        const p = number('dropRate');
        const cost = number('attemptCost');
        if (!p || p <= 0 || p >= 100) return show('확률은 0보다 크고 100보다 작아야 합니다.');
        const needed = (target: number) => Math.ceil(Math.log(1 - target / 100) / Math.log(1 - p / 100));
        const fifty = needed(50);
        const ninety = needed(90);
        const n99x = needed(99);
        const totalValue = document.getElementById('gachaCostValue');
        const breakdownValue = document.getElementById('gachaCostBreakdownValue');
        if (totalValue) totalValue.textContent = `${fifty.toLocaleString('ko-KR')}회 (${money(fifty * cost)})`;
        if (breakdownValue) breakdownValue.textContent = `50% ${fifty.toLocaleString('ko-KR')}회(${money(fifty * cost)}) · 90% ${ninety.toLocaleString('ko-KR')}회(${money(ninety * cost)}) · 99% ${n99x.toLocaleString('ko-KR')}회(${money(n99x * cost)})`;
        show(`50% 확률로 획득하려면 평균 ${fifty.toLocaleString('ko-KR')}회·${money(fifty * cost)}가 필요합니다.`);
      }
      if (type === 'sleep') {
        const wake = (document.getElementById('wakeTime') as HTMLInputElement | null)?.value || '';
        const cycles = Number((document.getElementById('sleepCycles') as HTMLSelectElement | null)?.value || 5);
        if (!wake) return show('');
        const parts = wake.split(':').map(Number);
        let totalMin = parts[0] * 60 + parts[1] - 15 - 90 * cycles;
        if (totalMin < 0) totalMin += 24 * 60;
        const bedH = String(Math.floor(totalMin / 60)).padStart(2, '0');
        const bedM = String(totalMin % 60).padStart(2, '0');
        const totalValue = document.getElementById('sleepValue');
        const breakdownValue = document.getElementById('sleepBreakdownValue');
        if (totalValue) totalValue.textContent = `${bedH}:${bedM}`;
        if (breakdownValue) breakdownValue.textContent = `${cycles}주기 · ${cycles * 1.5}시간 수면 (입수 15분 포함)`;
        show(`${wake} 기상 기준으로 ${bedH}:${bedM}에 취침하면 ${cycles * 1.5}시간 수면이 가능합니다.`);
      }
      if (type === 'book-read') {
        const pages = number('bookPages');
        const perMin = number('pagesPerMin');
        const start = (document.getElementById('bookStart') as HTMLInputElement | null)?.value || '';
        if (!pages || !perMin || perMin <= 0) return show('');
        const minutes = Math.ceil(pages / perMin);
        const hours = Math.floor(minutes / 60);
        const mins = minutes % 60;
        let endText = '';
        if (start) {
          const parts = start.split(':').map(Number);
          let t = parts[0] * 60 + parts[1] + minutes;
          const days = Math.floor(t / 1440);
          t %= 1440;
          const eh = String(Math.floor(t / 60)).padStart(2, '0');
          const em = String(t % 60).padStart(2, '0');
          endText = days > 0 ? `${eh}:${em} (+${days}일)` : `${eh}:${em}`;
        }
        const totalValue = document.getElementById('bookReadValue');
        const breakdownValue = document.getElementById('bookReadBreakdownValue');
        if (totalValue) totalValue.textContent = hours > 0 ? `${hours}시간 ${mins}분` : `${mins}분`;
        if (breakdownValue) breakdownValue.textContent = endText ? `완독 ${endText} (분당 ${perMin}쪽)` : `분당 ${perMin}쪽`;
        show(`총 ${minutes.toLocaleString('ko-KR')}분${endText ? `, ${start} 시작 시 ${endText} 완독` : ''}이 소요됩니다.`);
      }
      if (type === 'json-csv') {
        const text = (document.getElementById('jsonCsvInput') as HTMLTextAreaElement | null)?.value || '';
        const dir = (document.getElementById('jsonCsvDir') as HTMLSelectElement | null)?.value || 'json2csv';
        if (!text) return show('');
        let out = '';
        let rows = 0;
        try {
          if (dir === 'json2csv') {
            const data = JSON.parse(text);
            if (!Array.isArray(data) || data.length === 0) throw new Error('bad');
            const headers = Object.keys(data[0]);
            const escCell = (v: unknown) => {
              const s = v === null || v === undefined ? '' : String(v);
              return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
            };
            out = headers.join(',') + '\n' + data.map((row) => headers.map((h) => escCell((row as Record<string, unknown>)[h])).join(',')).join('\n');
            rows = data.length;
          } else {
            const lines = text.split(/\r?\n/).map((l) => l.trim()).filter((l) => l.length > 0);
            if (lines.length < 2) throw new Error('bad');
            const parseLine = (l: string) => {
              const res: string[] = [];
              let cur = '';
              let inQ = false;
              for (let i = 0; i < l.length; i++) {
                const chn = l[i];
                if (inQ) {
                  if (chn === '"') {
                    if (l[i + 1] === '"') { cur += '"'; i++; }
                    else inQ = false;
                  } else cur += chn;
                } else if (chn === '"') inQ = true;
                else if (chn === ',') { res.push(cur); cur = ''; }
                else cur += chn;
              }
              res.push(cur);
              return res;
            };
            const headers = parseLine(lines[0]);
            const arr = lines.slice(1).map((l) => {
              const vals = parseLine(l);
              const o: Record<string, string> = {};
              headers.forEach((h, i) => { o[h.trim()] = (vals[i] ?? '').trim(); });
              return o;
            });
            out = JSON.stringify(arr, null, 2);
            rows = arr.length;
          }
        } catch {
          show('입력 형식을 확인해야 합니다.');
          return;
        }
        const totalValue = document.getElementById('jsonCsvValue');
        const breakdownValue = document.getElementById('jsonCsvBreakdownValue');
        if (totalValue) totalValue.textContent = out;
        if (breakdownValue) breakdownValue.textContent = `${dir === 'json2csv' ? 'JSON→CSV' : 'CSV→JSON'} · ${rows}행`;
        const escaped = out.replace(/[<>&]/g, (m) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[m] || m));
        show(escaped.length > 400 ? escaped.slice(0, 400) + '…' : escaped);
      }
      if (type === 'sha-hash') {
        const text = (document.getElementById('hashText') as HTMLTextAreaElement | null)?.value || '';
        const algo = (document.getElementById('hashAlgo') as HTMLSelectElement | null)?.value || 'SHA-256';
        if (!text) return show('');
        (async () => {
          try {
            const digest = await crypto.subtle.digest(algo, new TextEncoder().encode(text));
            const hex = Array.from(new Uint8Array(digest)).map((b) => b.toString(16).padStart(2, '0')).join('');
            const totalValue = document.getElementById('shaHashValue');
            const breakdownValue = document.getElementById('shaHashBreakdownValue');
            if (totalValue) totalValue.textContent = hex;
            if (breakdownValue) breakdownValue.textContent = `${algo} · ${hex.length}자 (${hex.length / 2}바이트)`;
            show(hex.length > 400 ? hex.slice(0, 400) + '…' : hex);
          } catch {
            show('해시 생성에 실패했습니다. https 페이지에서만 동작합니다.');
          }
        })();
      }
      if (type === 'steps-kcal') {
        const steps = number('stepCount');
        const w = number('userWeight');
        const h = number('userHeight');
        const gender = (document.getElementById('userGender') as HTMLSelectElement | null)?.value || 'male';
        if (!steps || !w || !h || steps <= 0) return show('');
        const stride = (h * (gender === 'male' ? 0.45 : 0.43)) / 100;
        const km = (steps * stride) / 1000;
        const kcal = km * w * 0.72;
        const totalValue = document.getElementById('stepsKcalValue');
        const breakdownValue = document.getElementById('stepsKcalBreakdownValue');
        if (totalValue) totalValue.textContent = `${km.toFixed(2)}km · ${Math.round(kcal).toLocaleString('ko-KR')}kcal`;
        if (breakdownValue) breakdownValue.textContent = `보폭 ${(stride * 100).toFixed(1)}cm`;
        show(`${steps.toLocaleString('ko-KR')}걸음은 약 ${km.toFixed(2)}km, ${Math.round(kcal).toLocaleString('ko-KR')}kcal입니다.`);
      }
      if (type === 'weight-goal') {
        const cur = number('currentWeight');
        const target = number('targetWeight');
        const rate = Number((document.getElementById('lossRate') as HTMLSelectElement | null)?.value || 0.5);
        if (!cur || !target || cur <= 0 || target <= 0) return show('');
        if (target > cur) { show('목표 체중은 현재 체중보다 작아야 합니다.'); return; }
        const weeks = Math.max(1, Math.ceil((cur - target) / rate));
        const end = new Date();
        end.setDate(end.getDate() + weeks * 7);
        const kcalDef = 500 * (rate / 0.5);
        const totalValue = document.getElementById('weightGoalValue');
        const breakdownValue = document.getElementById('weightGoalBreakdownValue');
        if (totalValue) totalValue.textContent = `${weeks}주 (${(weeks * 7).toLocaleString('ko-KR')}일)`;
        if (breakdownValue) breakdownValue.textContent = `${end.toLocaleDateString('ko-KR')} 달성 · 일일 약 ${Math.round(kcalDef).toLocaleString('ko-KR')}kcal 부족`;
        show(`목표 ${target}kg까지 주당 ${rate}kg으로 약 ${weeks}주가 걸립니다.`);
      }
      if (type === 'romanize') {
        const text = (document.getElementById('romanInput') as HTMLTextAreaElement | null)?.value || '';
        const standard = (document.getElementById('romanStandard') as HTMLSelectElement | null)?.value || 'revised';
        if (!text) return show('');
        const outV = romanize(text, standard);
        const totalValue = document.getElementById('romanValue');
        const breakdownValue = document.getElementById('romanBreakdownValue');
        if (totalValue) totalValue.textContent = outV;
        if (breakdownValue) breakdownValue.textContent = `음절별 단순 변환 · ${text.length}자`;
        show(outV);
      }
    }

    form?.addEventListener('input', () => {
      if (type === 'lunch-picker-full' || type === 'who-pays') return;
      if (type === 'counter') {
        const text = (document.getElementById('text') as HTMLTextAreaElement).value;
        show(`공백 포함 ${text.length.toLocaleString('ko-KR')}자 · 공백 제외 ${text.replace(/\s/g, '').length.toLocaleString('ko-KR')}자`);
        return;
      }
      calculate();
    });
    form?.addEventListener('change', () => {
      if (type === 'lunch-picker-full' || type === 'who-pays') return;
      if (type !== 'counter') calculate();
    });
    if (type === 'youtube-revenue') {
      const ytFields = new Set(['views', 'rpm', 'impressionRate', 'ctr']);
      form?.addEventListener('input', (event) => {
        const target = event.target as HTMLInputElement;
        if (ytFields.has(target.id)) formatNumberInput(target, target.id !== 'views');
      });
    }
    form?.querySelector('[data-lotto-button]')?.addEventListener('click', () => calculate());
    form?.querySelector('[data-file-action]')?.addEventListener('click', async () => {
      const selected = file();
      if (!selected) return show('');
      const width = number('targetWidth') || 0;
      const quality = Math.min(100, Math.max(10, number('quality') || 82)) / 100;
      try {
        if (selected.type.startsWith('image/')) {
          const img = await loadImage(selected);
          const targetWidth = Math.min(width || img.naturalWidth, img.naturalWidth);
          const isJpg = slug.includes('jpg') || slug.includes('compressor') || slug.includes('resizer');
          const isWebp = slug.includes('webp-converter');
          const isRotate = slug.includes('rotate-flip');
          const canvas = drawImage(img, targetWidth, isRotate, isJpg ? '#fff' : '');
          const mime = isWebp ? 'image/webp' : isJpg ? 'image/jpeg' : 'image/png';
          const ext = isWebp ? 'webp' : isJpg ? 'jpg' : 'png';
          const blob = await canvasToBlob(canvas, mime, quality);
          downloadBlob(blob, outName(selected, isRotate ? 'rotated' : 'converted', ext));
          show(`다운로드 완료: ${(blob.size / 1024 / 1024).toFixed(2)}MB`);
          return;
        }
        if (selected.type.startsWith('audio/') || selected.type.startsWith('video/')) {
          const media = document.createElement(selected.type.startsWith('audio/') ? 'audio' : 'video') as HTMLMediaElement;
          media.preload = 'metadata';
          media.src = URL.createObjectURL(selected);
          media.onloadedmetadata = () => show(`길이 ${Math.round(media.duration)}초 · ${selected.type} · ${(selected.size / 1024 / 1024).toFixed(2)}MB`);
          return;
        }
        show(`${selected.name} 파일을 확인했습니다.`);
      } catch {
        show('이 브라우저에서 처리할 수 없는 파일입니다.');
      }
    });
  </script>

  <script is:inline>
    (function() {
      const slug = document.querySelector('[data-slug]')?.dataset.slug || '';
      const likeBtn = document.getElementById('feedbackLike');
      const dislikeBtn = document.getElementById('feedbackDislike');
      const formWrap = document.getElementById('feedbackFormWrap');
      const submitBtn = document.getElementById('feedbackSubmit');
      const textarea = document.getElementById('feedbackMessage');
      let vote = '';

      async function sendFeedback(v, message) {
        submitBtn.disabled = true;
        submitBtn.textContent = '보내는 중…';
        try {
          const res = await fetch('https://formspree.io/f/mjggknek', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ tool: slug, message: message })
          });
          if (res.ok) {
            formWrap.classList.add('hidden');
            likeBtn.disabled = true;
            dislikeBtn.disabled = true;
            const toast = document.getElementById('toast');
            if (toast) { toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 2500); }
          } else {
            submitBtn.disabled = false;
            submitBtn.textContent = '보내기';
            alert('전송에 실패했습니다. 다시 시도해야 합니다.');
          }
        } catch {
          submitBtn.disabled = false;
          submitBtn.textContent = '보내기';
          alert('전송에 실패했습니다. 다시 시도해야 합니다.');
        }
      }

      likeBtn?.addEventListener('click', () => {
        vote = 'like';
        likeBtn.classList.add('active');
        dislikeBtn.classList.remove('active');
        likeBtn.disabled = true;
        dislikeBtn.disabled = true;
        const toast = document.getElementById('toast');
        if (toast) { toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 2500); }
      });

      dislikeBtn?.addEventListener('click', () => {
        vote = 'dislike';
        dislikeBtn.classList.add('active');
        likeBtn.classList.remove('active');
        formWrap.classList.remove('hidden');
        textarea.focus();
      });

      submitBtn?.addEventListener('click', () => {
        const message = textarea?.value?.trim() || '';
        if (!message) { textarea.focus(); return; }
        sendFeedback('dislike', message);
      });
    })();
  </script>
</BaseLayout>
