    function loadSftScript(src: string) {
      const normalized = src.replace(/\?.*$/, '');
      if (loadedSftScripts.has(normalized)) return Promise.resolve();
      loadedSftScripts.add(normalized);
      return new Promise<void>((resolve, reject) => {
        const script = document.createElement('script');
        script.src = normalized;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error(`SFT script load failed: ${normalized}`));
        document.body.appendChild(script);
      });
    }

    async function setupSftOriginalTool() {
      if (!form || !slug) return false;
      try {
        const [fragmentResponse, mapResponse, translationResponse] = await Promise.all([
          fetch(`/sft-tool-fragments/${slug}.html`),
          fetch('/sft-tool-map.json'),
          fetch('/sft-ko-translations.json'),
        ]);
        if (!fragmentResponse.ok || !mapResponse.ok) return false;
        const fragment = await fragmentResponse.text();
        const map = await mapResponse.json();
        sftKoTranslations = translationResponse.ok ? await translationResponse.json() : null;
        const config = map[slug] || {};
        form.innerHTML = fragment;
        syncSftMeta(form);
        syncSftIcon(form);
        applySftKorean(form);
        localizeFileInputs(form);
        localizeRangeInputs(form);
        if (config.config) {
          new Function(config.config)();
        } else {
          (window as any).SFT_TOOL_PAGE = { slug };
        }
        const scripts = Array.isArray(config.scripts) ? config.scripts : [];
        for (const src of scripts) {
          await loadSftScript(src);
        }
        for (const name of sftInitializers) {
          const initializer = (window as any)[name];
          if (typeof initializer === 'function') {
            try { initializer(); } catch (error) { console.warn(`${name} skipped`, error); }
          }
        }
        applySftKorean(form);
        syncSftMeta(form);
        syncSftIcon(form);
        localizeFileInputs(form);
        localizeRangeInputs(form);
        observeSftKorean(form);
        panel?.classList.add('is-sft-ready');
        return true;
      } catch (error) {
        console.warn('SFT original tool failed, fallback template will be used.', error);
        return false;
      }
    }

    function syncSftIcon(root: HTMLElement) {
      if (!toolIcon) return;
      root.querySelectorAll<HTMLElement>('.card-content .w-12.h-12').forEach((iconBox) => {
        iconBox.textContent = toolIcon;
        iconBox.setAttribute('aria-hidden', 'true');
      });
    }

    function syncSftMeta(root: HTMLElement) {
      const title = root.querySelector<HTMLElement>('.card-content h1');
      const description = root.querySelector<HTMLElement>('.card-content .card-description');
      if (title && toolTitle) title.textContent = toolTitle;
      if (description && toolDescription) description.textContent = toolDescription;
    }

    function localizeFileInputs(root: HTMLElement) {
      root.querySelectorAll<HTMLInputElement>('input[type="file"]:not([data-sft-file-localized])').forEach((input) => {
        input.dataset.sftFileLocalized = 'true';
        input.classList.add('sft-native-file-input');

        const picker = document.createElement('div');
        picker.className = 'sft-file-input';

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'sft-file-button';
        button.textContent = '파일 선택';
        button.addEventListener('click', () => input.click());

        const name = document.createElement('span');
        name.className = 'sft-file-name';
        name.textContent = '선택된 파일 없음';

        input.addEventListener('change', () => {
          const files = Array.from(input.files || []);
          name.textContent = files.length
            ? files.map((file) => file.name).join(', ')
            : '선택된 파일 없음';
        });

        picker.append(button, name);
        input.insertAdjacentElement('afterend', picker);
      });
    }

    function updateRangeProgress(input: HTMLInputElement) {
      const min = Number(input.min || 0);
      const max = Number(input.max || 100);
      const value = Number(input.value || min);
      const progress = max === min
        ? 0
        : Math.min(100, Math.max(0, ((value - min) / (max - min)) * 100));
      input.style.setProperty('--range-progress', `${progress}%`);
    }

    function localizeRangeInputs(root: HTMLElement) {
      root.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach((input) => {
        input.classList.add('sft-range-input');
        updateRangeProgress(input);
        if (input.dataset.sftRangeLocalized === 'true') return;
        input.dataset.sftRangeLocalized = 'true';
        input.addEventListener('input', () => updateRangeProgress(input));
        input.addEventListener('change', () => updateRangeProgress(input));
      });
    }

    function translateSftText(value: string) {
      const trimmed = value.trim();
      if (!trimmed) return value;
      return sftBuiltInTranslations[trimmed] || sftKoTranslations?.[trimmed] || value;
    }

    function applySftKorean(root: HTMLElement) {
      if (isApplyingSftKorean) return;
      isApplyingSftKorean = true;
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      const textNodes: Text[] = [];
      while (walker.nextNode()) {
        const node = walker.currentNode as Text;
        if (!node.nodeValue || !node.nodeValue.trim()) continue;
        if (node.parentElement?.closest('[data-sft-no-translate]')) continue;
        textNodes.push(node);
      }
      textNodes.forEach((node) => {
        const translated = translateSftText(node.nodeValue || '');
        if (translated !== node.nodeValue) node.nodeValue = translated;
      });
      root.querySelectorAll<HTMLElement>('[placeholder], [aria-label], [title]').forEach((element) => {
        ['placeholder', 'aria-label', 'title'].forEach((attr) => {
          const value = element.getAttribute(attr);
          if (!value) return;
          const translated = translateSftText(value);
          if (translated !== value) element.setAttribute(attr, translated);
        });
      });
      isApplyingSftKorean = false;
    }

    function observeSftKorean(root: HTMLElement) {
      const observer = new MutationObserver(() => {
        if (isApplyingSftKorean) return;
        window.requestAnimationFrame(() => {
          applySftKorean(root);
          syncSftMeta(root);
          localizeFileInputs(root);
          localizeRangeInputs(root);
        });
      });
      observer.observe(root, {
        childList: true,
        characterData: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['placeholder', 'aria-label', 'title', 'value'],
      });
    }

