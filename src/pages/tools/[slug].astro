    const JUNG_COMBO: Record<string, string> = { 'ㅗㅏ': 'ㅘ', 'ㅗㅐ': 'ㅙ', 'ㅗㅣ': 'ㅚ', 'ㅜㅓ': 'ㅝ', 'ㅜㅔ': 'ㅞ', 'ㅜㅣ': 'ㅟ', 'ㅡㅣ': 'ㅢ' };
    function enToKo(input: string) {
      let out = '';
      let cho = -1;
      let jung = -1;
      let jong = -1;
      let jongChar = '';
      const flush = (dropJong = false) => {
        if (cho >= 0 && jung >= 0) out += String.fromCodePoint(0xac00 + cho * 588 + jung * 28 + (dropJong ? 0 : Math.max(0, jong)));
        else if (cho >= 0) out += CHOS[cho];
        else if (jung >= 0) out += JUNG[jung];
        else if (jong >= 0) out += JONG[jong];
        cho = -1; jung = -1; jong = -1; jongChar = '';
      };
      for (const ch of input) {
        const jamo = KEY_TO_JAMO[ch];
        if (!jamo) { flush(); out += ch; continue; }
        if (jamo in jungIdxOf) {
          if (jung < 0) {
            if (cho < 0) cho = choIdxOf['ㅇ'];
            jung = jungIdxOf[jamo];
          } else {
            const combo = JUNG_COMBO[JUNG[jung] + jamo];
            if (combo && jong < 0) {
              jung = jungIdxOf[combo];
            } else {
              const reopenChar = jong >= 0 ? jongChar : '';
              flush(reopenChar.length > 0);
              cho = reopenChar ? (reopenChar in choIdxOf ? choIdxOf[reopenChar] : -1) : choIdxOf['ㅇ'];
              jung = jungIdxOf[jamo];
            }
          }
        } else if (jamo in choIdxOf) {
          if (cho >= 0 && jung >= 0 && jong < 0) {
            jong = jamo in jongIdxOf ? jongIdxOf[jamo] : -1;
            jongChar = jamo;
          } else if (cho < 0) {
            cho = choIdxOf[jamo];
          } else {
            flush();
            cho = choIdxOf[jamo];
          }
        } else if (jamo in jongIdxOf) {
          if (jung >= 0 && jong < 0 && cho >= 0) { jong = jongIdxOf[jamo]; jongChar = jamo; }
          else { flush(); cho = jamo in choIdxOf ? choIdxOf[jamo] : -1; }
        }
      }
      flush();
      return out;
    }
    function koToEn(input: string) {
      let out = '';
      for (const ch of input) {
        if (JAMO_TO_KEY[ch]) { out += JAMO_TO_KEY[ch]; continue; }
        const code = ch.codePointAt(0);
        if (typeof code === 'number' && code >= 0xac00 && code <= 0xd7a3) {
          const offset = code - 0xac00;
          const cho = Math.floor(offset / 588);
          const jung = Math.floor((offset % 588) / 28);
          const jong = offset % 28;
          out += JAMO_TO_KEY[CHOS[cho]] ?? '';
          const jungChar = JUNG[jung];
          for (const j of DECOMPOSE_JUNG[jungChar] || jungChar) out += JAMO_TO_KEY[j] ?? '';
          if (jong) {
            for (const j of DECOMPOSE_JONG[JONG[jong]] || JONG[jong]) out += JAMO_TO_KEY[j] ?? '';
          }
        } else {
          out += ch;
        }
      }
      return out;
    }

    const ROM_INITIAL: Record<string, string> = { 'ㄱ': 'g', 'ㄲ': 'kk', 'ㄴ': 'n', 'ㄷ': 'd', 'ㄸ': 'tt', 'ㄹ': 'r', 'ㅁ': 'm', 'ㅂ': 'b', 'ㅃ': 'pp', 'ㅅ': 's', 'ㅆ': 'ss', 'ㅇ': '', 'ㅈ': 'j', 'ㅉ': 'jj', 'ㅊ': 'ch', 'ㅋ': 'k', 'ㅌ': 't', 'ㅍ': 'p', 'ㅎ': 'h' };
    const ROM_VOWEL: Record<string, string> = { 'ㅏ': 'a', 'ㅐ': 'ae', 'ㅑ': 'ya', 'ㅒ': 'yae', 'ㅓ': 'eo', 'ㅔ': 'e', 'ㅕ': 'yeo', 'ㅖ': 'ye', 'ㅗ': 'o', 'ㅘ': 'wa', 'ㅙ': 'wae', 'ㅚ': 'oe', 'ㅛ': 'yo', 'ㅜ': 'u', 'ㅝ': 'wo', 'ㅞ': 'we', 'ㅟ': 'wi', 'ㅠ': 'yu', 'ㅡ': 'eu', 'ㅢ': 'ui', 'ㅣ': 'i' };
    const ROM_FINAL: Record<string, string> = { 'ㄱ': 'k', 'ㄲ': 'k', 'ㄳ': 'k', 'ㄴ': 'n', 'ㄵ': 'nt', 'ㄶ': 'nh', 'ㄷ': 't', 'ㄹ': 'l', 'ㄺ': 'k', 'ㄻ': 'm', 'ㄼ': 'l', 'ㄽ': 'l', 'ㄾ': 'l', 'ㄿ': 'p', 'ㅀ': 'l', 'ㅁ': 'm', 'ㅂ': 'p', 'ㅄ': 'p', 'ㅅ': 't', 'ㅆ': 't', 'ㅇ': 'ng', 'ㅈ': 't', 'ㅊ': 't', 'ㅋ': 'k', 'ㅌ': 't', 'ㅍ': 'p', 'ㅎ': 't' };
    const MC_INITIAL: Record<string, string> = { 'ㄱ': 'k', 'ㄲ': 'kk', 'ㄴ': 'n', 'ㄷ': 't', 'ㄸ': 'tt', 'ㄹ': 'r', 'ㅁ': 'm', 'ㅂ': 'p', 'ㅃ': 'pp', 'ㅅ': 's', 'ㅆ': 'ss', 'ㅇ': '', 'ㅈ': 'ch', 'ㅉ': 'tch', 'ㅊ': 'ch', 'ㅋ': 'k', 'ㅌ': 't', 'ㅍ': 'p', 'ㅎ': 'h' };
    const MC_VOWEL: Record<string, string> = { 'ㅏ': 'a', 'ㅐ': 'ae', 'ㅑ': 'ya', 'ㅒ': 'yae', 'ㅓ': 'ŏ', 'ㅔ': 'e', 'ㅕ': 'yŏ', 'ㅖ': 'ye', 'ㅗ': 'o', 'ㅘ': 'wa', 'ㅙ': 'wae', 'ㅚ': 'oe', 'ㅛ': 'yo', 'ㅜ': 'u', 'ㅝ': 'wŏ', 'ㅞ': 'we', 'ㅟ': 'wi', 'ㅠ': 'yu', 'ㅡ': 'ŭ', 'ㅢ': 'ŭi', 'ㅣ': 'i' };
    const MC_FINAL: Record<string, string> = { 'ㄱ': 'k', 'ㄲ': 'k', 'ㄳ': 'k', 'ㄴ': 'n', 'ㄵ': 'nt', 'ㄶ': 'nh', 'ㄷ': 't', 'ㄹ': 'l', 'ㄺ': 'k', 'ㄻ': 'm', 'ㄼ': 'l', 'ㄽ': 'l', 'ㄾ': 'l', 'ㄿ': 'p', 'ㅀ': 'l', 'ㅁ': 'm', 'ㅂ': 'p', 'ㅄ': 'p', 'ㅅ': 't', 'ㅆ': 't', 'ㅇ': 'ng', 'ㅈ': 't', 'ㅊ': 't', 'ㅋ': 'k', 'ㅌ': 't', 'ㅍ': 'p', 'ㅎ': 't' };
    function romanize(input: string, standard: string) {
      const init = standard === 'mccune' ? MC_INITIAL : ROM_INITIAL;
      const vow = standard === 'mccune' ? MC_VOWEL : ROM_VOWEL;
      const fin = standard === 'mccune' ? MC_FINAL : ROM_FINAL;
      let out = '';
      for (const ch of input) {
        const code = ch.codePointAt(0);
        if (init[ch]) { out += init[ch]; continue; }
        if (typeof code === 'number' && code >= 0xac00 && code <= 0xd7a3) {
          const offset = code - 0xac00;
          const cho = Math.floor(offset / 588);
          const jung = Math.floor((offset % 588) / 28);
          const jong = offset % 28;
          out += init[CHOS[cho]] + vow[JUNG[jung]];
          if (jong) out += fin[JONG[jong]] ?? '';
        } else {
          out += ch;
        }
      }
      return out;
    }

    function calculate() {
