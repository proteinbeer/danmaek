    function number(id: string) {
      const raw = (document.getElementById(id) as HTMLInputElement | null)?.value || '';
      return Number(raw.replace(/,/g, ''));
    }
    function formatNumberInput(input: HTMLInputElement, allowDecimal: boolean) {
      const caret = input.selectionStart ?? 0;
      const sanitized = input.value.replace(/,/g, '');
      let formatted: string;
      if (allowDecimal) {
        const digits = sanitized.replace(/[^0-9.]/g, '');
        const [intPart = '', ...rest] = digits.split('.');
        const decimals = rest.join('').slice(0, 2);
        formatted = (intPart.replace(/^0+(?=\d)/, '') || '0').replace(/\B(?=(\d{3})+(?!\d))/g, ',') + (decimals ? '.' + decimals : '');
      } else {
        const digits = sanitized.replace(/[^0-9]/g, '').replace(/^0+(?=\d)/, '');
        formatted = digits.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }
      input.value = formatted;
      input.setSelectionRange(Math.min(caret, input.value.length), Math.min(caret, input.value.length));
    }
    function money(value: number) {
      return Math.round(value).toLocaleString('ko-KR') + '원';
    }
    function fmt(value: number, digits = 4) {
      return Number.isFinite(value) ? Number(value.toFixed(digits)).toLocaleString('ko-KR') : '0';
    }
    function lines(id: string) {
      return ((document.getElementById(id) as HTMLTextAreaElement | null)?.value || '').split(/\n+/).map((item) => item.trim()).filter(Boolean);
    }
    function pick<T>(items: T[]) {
      return items[Math.floor(Math.random() * items.length)];
    }
    function show(text: string) {
      if (!result) return;
      result.textContent = text;
      result.hidden = !text;
    }
    function showHtml(html: string) {
      if (!result) return;
      result.innerHTML = html;
      result.hidden = !html;
    }
    function file() {
      return (document.getElementById('file') as HTMLInputElement | null)?.files?.[0] || null;
    }
    function downloadBlob(blob: Blob, filename: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1200);
    }
    function loadImage(srcFile: File) {
      return new Promise<HTMLImageElement>((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = URL.createObjectURL(srcFile);
      });
    }
    function canvasToBlob(canvas: HTMLCanvasElement, type = 'image/png', quality = .9) {
      return new Promise<Blob>((resolve, reject) => {
        canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('이미지 변환 실패')), type, quality);
      });
    }
    function drawImage(img: HTMLImageElement, width = img.naturalWidth, rotate = false, fill = '') {
      const ratio = img.naturalHeight / img.naturalWidth;
      const height = Math.max(1, Math.round(width * ratio));
      const canvas = document.createElement('canvas');
      canvas.width = rotate ? height : width;
      canvas.height = rotate ? width : height;
      const ctx = canvas.getContext('2d')!;
      if (fill) {
        ctx.fillStyle = fill;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }
      if (rotate) {
        ctx.translate(canvas.width, 0);
        ctx.rotate(Math.PI / 2);
        ctx.drawImage(img, 0, 0, width, height);
      } else {
        ctx.drawImage(img, 0, 0, width, height);
      }
      return canvas;
    }
    function outName(srcFile: File, suffix: string, ext: string) {
      return `${srcFile.name.replace(/\.[^/.]+$/, '')}-${suffix}.${ext}`;
    }

    if (useSftOriginal) {
      setupSftOriginalTool().then((loaded) => {
        if (!loaded && form && type) {
          form.innerHTML = templates[type] ?? '';
          localizeFileInputs(form);
          localizeRangeInputs(form);
        }
      });
    } else if (form && type) {
      form.innerHTML = templates[type] ?? '';
      localizeFileInputs(form);
      localizeRangeInputs(form);
    }

    function calculate() {
      if (type === 'bmi') {
        const h = number('height') / 100;
        const w = number('weight');
        if (!h || !w) return show('');
        const bmi = w / (h * h);
        show(`BMI는 ${bmi.toFixed(1)}입니다.`);
      }
      if (type === 'age') {
        const birth = new Date((document.getElementById('birth') as HTMLInputElement).value);
        if (Number.isNaN(birth.getTime())) return show('');
        const today = new Date();
        let age = today.getFullYear() - birth.getFullYear();
        const passed = today.getMonth() > birth.getMonth() || (today.getMonth() === birth.getMonth() && today.getDate() >= birth.getDate());
        if (!passed) age -= 1;
        show(`현재 만 나이는 ${age}세입니다.`);
      }
      if (type === 'date-diff') {
        const start = new Date((document.getElementById('start') as HTMLInputElement).value);
        const end = new Date((document.getElementById('end') as HTMLInputElement).value);
        if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) return show('');
        show(`두 날짜 차이는 ${Math.abs(Math.round((end.getTime() - start.getTime()) / 86400000)).toLocaleString('ko-KR')}일입니다.`);
      }
      if (type === 'discount') {
        const price = number('price');
        const rate = number('rate');
        if (!price && !rate) return show('');
        show(`할인가는 ${money(price * (1 - rate / 100))}, 할인 금액은 ${money(price * rate / 100)}입니다.`);
      }
      if (type === 'tip') {
        const amount = number('amount');
        const tip = amount * number('tip') / 100;
        if (!amount && !tip) return show('');
        show(`팁은 ${money(tip)}, 총액은 ${money(amount + tip)}입니다.`);
      }
      if (type === 'compound') {
        if (!number('principal') && !number('rate') && !number('years')) return show('');
        const total = number('principal') * Math.pow(1 + number('rate') / 100, number('years'));
        show(`예상 금액은 ${money(total)}입니다.`);
      }
      if (type === 'random') {
        const min = Math.ceil(number('min'));
        const max = Math.floor(number('max'));
        if (!min && !max) return show('');
        if (max < min) return show('');
        show(`뽑힌 숫자: ${Math.floor(Math.random() * (max - min + 1)) + min}`);
      }
      if (type === 'storage') {
        const value = number('value');
        const unit = (document.getElementById('unit') as HTMLSelectElement).value;
        const kb = value * ({ KB: 1, MB: 1024, GB: 1048576, TB: 1073741824 } as Record<string, number>)[unit];
        show(`${kb.toLocaleString('ko-KR')} KB · ${(kb / 1024).toLocaleString('ko-KR')} MB · ${(kb / 1048576).toLocaleString('ko-KR')} GB`);
      }
      if (type === 'color') {
        const raw = ((document.getElementById('hex') as HTMLInputElement).value || '').replace('#', '').trim();
        if (!/^[0-9a-fA-F]{6}$/.test(raw)) return show('');
        const r = parseInt(raw.slice(0, 2), 16);
        const g = parseInt(raw.slice(2, 4), 16);
        const b = parseInt(raw.slice(4, 6), 16);
        show(`RGB(${r}, ${g}, ${b})`);
      }
      if (type === 'calorie') {
        const gender = (document.getElementById('gender') as HTMLSelectElement).value;
        const years = number('years');
        const height = number('height');
        const weight = number('weight');
        if (!years || !height || !weight) return show('');
        const bmr = gender === 'male'
          ? 10 * weight + 6.25 * height - 5 * years + 5
          : 10 * weight + 6.25 * height - 5 * years - 161;
        show(`기초대사량은 약 ${Math.round(bmr).toLocaleString('ko-KR')} kcal, 보통 활동 기준은 약 ${Math.round(bmr * 1.35).toLocaleString('ko-KR')} kcal입니다.`);
      }
      if (type === 'fuel') {
        const distance = number('distance');
        const efficiency = number('efficiency');
        const price = number('price');
        if (!distance || !efficiency || !price) return show('');
        show(`예상 연료비는 ${money(distance / efficiency * price)}입니다.`);
      }
      if (type === 'gpa') {
        const rows = [1, 2, 3].map((n) => ({ credit: number(`credit${n}`), grade: number(`grade${n}`) })).filter((row) => row.credit > 0);
        const credits = rows.reduce((sum, row) => sum + row.credit, 0);
        if (!credits) return show('');
        const score = rows.reduce((sum, row) => sum + row.credit * row.grade, 0) / credits;
        show(`평균 평점은 ${score.toFixed(2)}입니다.`);
      }
      if (type === 'loan' || type === 'mortgage') {
        const principal = number('principal');
        const rate = number('rate') / 100 / 12;
        const months = type === 'mortgage' ? number('years') * 12 : number('months');
        if (!principal || !months) return show('');
        const payment = rate ? principal * rate * Math.pow(1 + rate, months) / (Math.pow(1 + rate, months) - 1) : principal / months;
        show(`예상 월 상환액은 ${money(payment)}입니다.`);
      }
      if (type === 'percentage') {
        const base = number('base');
        const value = number('value');
        if (!base && !value) return show('');
        show(`${value.toLocaleString('ko-KR')}는 ${base.toLocaleString('ko-KR')}의 ${base ? (value / base * 100).toFixed(2) : '0.00'}%입니다.`);
      }
      if (type === 'profit-loss') {
        const buy = number('buy');
        const sell = number('sell');
        const qty = number('qty') || 1;
        if (!buy || !sell) return show('');
        const profit = (sell - buy) * qty;
        show(`손익은 ${money(profit)}, 수익률은 ${((sell - buy) / buy * 100).toFixed(2)}%입니다.`);
      }
      if (type === 'sales-tax') {
        const amount = number('amount');
        const tax = amount * number('rate') / 100;
        if (!amount && !tax) return show('');
        show(`세금은 ${money(tax)}, 최종 금액은 ${money(amount + tax)}입니다.`);
      }
      if (type === 'avg-cost') {
        const oldQty = number('oldQty');
        const oldPrice = number('oldPrice');
        const newQty = number('newQty');
        const newPrice = number('newPrice');
        if (!oldQty && !newQty) return show('');
        const totalQty = oldQty + newQty;
        const avg = totalQty ? (oldQty * oldPrice + newQty * newPrice) / totalQty : 0;
        show(`총 수량은 ${totalQty.toLocaleString('ko-KR')}개, 평균 단가는 ${money(avg)}입니다.`);
      }
      if (type === 'time-duration') {
        const start = (document.getElementById('startTime') as HTMLInputElement).value;
        const end = (document.getElementById('endTime') as HTMLInputElement).value;
        if (!start || !end) return show('');
        const [sh, sm] = start.split(':').map(Number);
        const [eh, em] = end.split(':').map(Number);
        let minutes = eh * 60 + em - (sh * 60 + sm);
        if (minutes < 0) minutes += 1440;
        show(`차이는 ${Math.floor(minutes / 60)}시간 ${minutes % 60}분입니다.`);
      }
      if (type === 'youtube-revenue') {
        const views = number('views');
        const rpm = number('rpm');
        const impressionRate = number('impressionRate');
        const ctr = number('ctr');
        const revenueValue = document.getElementById('youtubeRevenueValue');
        const impressionsValue = document.getElementById('youtubeImpressionsValue');
        const cpmValue = document.getElementById('youtubeCpmValue');
        if (!views || !rpm) {
          show('');
          [revenueValue, impressionsValue, cpmValue].forEach((el) => { if (el) el.textContent = '—'; });
          return;
        }
        const impressions = views * impressionRate / 100;
        const clicks = impressions * ctr / 100;
        const revenue = views * rpm / 1000;
        const cpm = impressions ? revenue / impressions * 1000 : 0;
        show(`예상 광고 수익 ${money(revenue)}, 광고 노출 ${Math.round(impressions).toLocaleString('ko-KR')}회 · 예상 클릭 ${Math.round(clicks).toLocaleString('ko-KR')}회 · 환산 CPM ${fmt(cpm)}원`);
        if (revenueValue) revenueValue.textContent = money(revenue);
        if (impressionsValue) impressionsValue.textContent = `${Math.round(impressions).toLocaleString('ko-KR')}회 · 클릭 ${Math.round(clicks).toLocaleString('ko-KR')}회`;
        if (cpmValue) cpmValue.textContent = `${fmt(cpm)}원`;
      }
      if (type === 'angle') {
        const value = number('value');
        const unit = (document.getElementById('unit') as HTMLSelectElement).value;
        if (!value) return show('');
        const deg = unit === 'rad' ? value * 180 / Math.PI : unit === 'grad' ? value * 0.9 : value;
        show(`${fmt(deg)}도 · ${fmt(deg * Math.PI / 180)}rad · ${fmt(deg / 0.9)}grad`);
      }
      if (type === 'area') {
        const value = number('value');
        const unit = (document.getElementById('unit') as HTMLSelectElement).value;
        if (!value) return show('');
        const sqm = value * ({ sqm: 1, pyeong: 3.305785, acre: 4046.8564224, sqft: 0.092903 } as Record<string, number>)[unit];
        show(`${fmt(sqm)}㎡ · ${fmt(sqm / 3.305785)}평 · ${fmt(sqm / 4046.8564224)}에이커 · ${fmt(sqm / 0.092903)}ft²`);
      }
      if (type === 'energy') {
        const value = number('value');
        const unit = (document.getElementById('unit') as HTMLSelectElement).value;
        if (!value) return show('');
        const j = value * ({ j: 1, kj: 1000, kcal: 4184, wh: 3600 } as Record<string, number>)[unit];
        show(`${fmt(j)}J · ${fmt(j / 1000)}kJ · ${fmt(j / 4184)}kcal · ${fmt(j / 3600)}Wh`);
      }
      if (type === 'frequency') {
        const value = number('value');
        const unit = (document.getElementById('unit') as HTMLSelectElement).value;
        if (!value) return show('');
        const hz = value * ({ hz: 1, khz: 1000, mhz: 1000000, ghz: 1000000000 } as Record<string, number>)[unit];
        show(`${fmt(hz)}Hz · ${fmt(hz / 1000)}kHz · ${fmt(hz / 1000000)}MHz · ${fmt(hz / 1000000000)}GHz`);
      }
      if (type === 'speed') {
        const value = number('value');
        const unit = (document.getElementById('unit') as HTMLSelectElement).value;
        if (!value) return show('');
        const ms = value * ({ ms: 1, kmh: 1 / 3.6, mph: 0.44704, knot: 0.514444 } as Record<string, number>)[unit];
        show(`${fmt(ms)}m/s · ${fmt(ms * 3.6)}km/h · ${fmt(ms / 0.44704)}mph · ${fmt(ms / 0.514444)}knot`);
      }
      if (type === 'volume') {
        const value = number('value');
        const unit = (document.getElementById('unit') as HTMLSelectElement).value;
        if (!value) return show('');
        const l = value * ({ l: 1, ml: 0.001, gal: 3.785411784, cup: 0.24 } as Record<string, number>)[unit];
        show(`${fmt(l)}L · ${fmt(l * 1000)}mL · ${fmt(l / 3.785411784)}gal · ${fmt(l / 0.24)}cup`);
      }
      if (type === 'power') {
        const value = number('value');
        const unit = (document.getElementById('unit') as HTMLSelectElement).value;
        if (!value) return show('');
        const w = value * ({ w: 1, kw: 1000, hp: 745.7 } as Record<string, number>)[unit];
        show(`${fmt(w)}W · ${fmt(w / 1000)}kW · ${fmt(w / 745.7)}hp`);
      }
      if (type === 'pressure') {
        const value = number('value');
        const unit = (document.getElementById('unit') as HTMLSelectElement).value;
        if (!value) return show('');
        const pa = value * ({ pa: 1, kpa: 1000, bar: 100000, psi: 6894.757 } as Record<string, number>)[unit];
        show(`${fmt(pa)}Pa · ${fmt(pa / 1000)}kPa · ${fmt(pa / 100000)}bar · ${fmt(pa / 6894.757)}psi`);
      }
      if (type === 'unit') {
        const value = number('value');
        const kind = (document.getElementById('kind') as HTMLSelectElement).value;
        if (!value) return show('');
        if (kind === 'length') show(`${fmt(value)}m · ${fmt(value * 100)}cm · ${fmt(value / 1000)}km · ${fmt(value * 3.28084)}ft`);
        else show(`${fmt(value)}kg · ${fmt(value * 1000)}g · ${fmt(value * 2.20462)}lb · ${fmt(value * 35.274)}oz`);
      }
      if (type === 'number-base') {
        const value = Math.trunc(number('decimal'));
        if (!value) return show('');
        show(`2진수 ${value.toString(2)} · 8진수 ${value.toString(8)} · 16진수 ${value.toString(16).toUpperCase()}`);
      }
      if (type === 'timestamp') {
        const value = number('timestamp');
        if (!value) return show('');
        show(new Date(value * 1000).toLocaleString('ko-KR'));
      }
      if (type === 'time-zone') {
        const raw = (document.getElementById('utcTime') as HTMLInputElement).value;
        if (!raw) return show('');
        const date = new Date(raw + 'Z');
        show(`한국 ${date.toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' })} · 뉴욕 ${date.toLocaleString('ko-KR', { timeZone: 'America/New_York' })} · 런던 ${date.toLocaleString('ko-KR', { timeZone: 'Europe/London' })}`);
      }
      if (type === 'username') {
        const keyword = ((document.getElementById('keyword') as HTMLInputElement).value || 'danmaek').toLowerCase().replace(/[^a-z0-9]/g, '') || 'danmaek';
        show([`${keyword}${Math.floor(Math.random() * 900 + 100)}`, `${keyword}.note`, `real.${keyword}`, `${keyword}_day`].join(' · '));
      }
      if (type === 'uuid') {
        const count = Math.max(1, Math.min(10, Math.trunc(number('count') || 1)));
        show(Array.from({ length: count }, () => crypto.randomUUID()).join('\n'));
      }
      if (type === 'password') {
        const length = Math.max(6, Math.min(64, Math.trunc(number('length') || 16)));
        const symbols = (document.getElementById('symbols') as HTMLSelectElement).value === 'yes';
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789' + (symbols ? '!@#$%^&*?' : '');
        show(Array.from({ length }, () => chars[Math.floor(Math.random() * chars.length)]).join(''));
      }
      if (type === 'random-team') {
        const names = lines('names');
        const teamCount = Math.max(2, Math.trunc(number('teams') || 2));
        if (!names.length) return show('');
        const shuffled = [...names].sort(() => Math.random() - 0.5);
        const teams = Array.from({ length: teamCount }, (_, i) => `팀 ${i + 1}: ${shuffled.filter((_, idx) => idx % teamCount === i).join(', ')}`);
        show(teams.join('\n'));
