---
import BaseLayout from '../../components/BaseLayout.astro';
import { SITE } from '../../consts';
---
<BaseLayout title={`문의 | ${SITE.name}`} description="단맥 운영자에게 문의를 보낼 수 있는 페이지입니다." canonical={new URL('/contact/', SITE.url).toString()}>
  <main class="container contact-page">
    <section class="container" aria-labelledby="contact-title">
      <div class="section-head">
        <div>
          <h2 id="contact-title">문의</h2>
        </div>
      </div>
      <article class="featured">
        <div>
          <p>답장이 필요하신 경우 이메일 주소를 정확히 적어 주세요.</p>
        </div>
        <form class="contact-form" id="contact-form">
          <label>
            이름
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            이메일
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            내용
            <textarea name="message" rows="7" required></textarea>
          </label>
          <input type="hidden" name="_subject" value="단맥 문의" />
          <button type="submit">보내기</button>
        </form>
      </article>
    </section>
    <div class="tool-coupang tool-coupang--sm">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021110,"template":"carousel","trackingCode":"AF7638395","width":"250","height":"250","tsource":""});
</script>
    </div>
    <div class="tool-coupang tool-coupang--lg">
<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
<script is:inline>
	new PartnersCoupang.G({"id":1021235,"trackingCode":"AF7638395","subId":null,"template":"carousel","width":"662","height":"140"});
</script>
    </div>
    <div class="toast" id="toast">전송되었습니다</div>
  </main>
  <script is:inline>
    document.getElementById('contact-form')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const form = e.target;
      const data = new FormData(form);
      const btn = form.querySelector('button');
      btn.disabled = true;
      btn.textContent = '보내는 중…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { 'Accept': 'application/json' } });
        if (res.ok) {
          const toast = document.getElementById('toast');
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2500);
          form.reset();
          btn.disabled = false;
          btn.textContent = '보내기';
        } else {
          btn.disabled = false;
          btn.textContent = '보내기';
          alert('전송에 실패했습니다. 다시 시도해 주세요.');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = '보내기';
        alert('전송에 실패했습니다. 다시 시도해 주세요.');
      }
    });
  </script>
</BaseLayout>
