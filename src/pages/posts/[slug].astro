---
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = getPosts();
  return posts.map((post, index) => {
    const isGuide = post.data.category === '가이드';
    const pool = isGuide
      ? posts.filter((item) => item.data.category === '가이드')
      : posts.filter((item) => item.data.category !== '가이드');
    const indexInPool = pool.findIndex((item) => item.id === post.id);
    const relatedByCategory = pool.filter((item) => item.id !== post.id && item.data.category === post.data.category);
    const relatedFallback = pool.filter((item) => item.id !== post.id && item.data.category !== post.data.category);
    const related = [...relatedByCategory, ...relatedFallback].slice(0, 3);
    return {
      params: { slug: post.id },
      props: {
        post,
        prev: pool[indexInPool - 1] ?? null,
        next: pool[indexInPool + 1] ?? null,
        related
      }
    };
  });
}
const { post, prev, next, related } = Astro.props;
---
<PostLayout post={post} prev={prev} next={next} related={related} />
