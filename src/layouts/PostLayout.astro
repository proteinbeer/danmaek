---
import BaseLayout from '../components/BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import PostCard from '../components/PostCard.astro';
import LocalPostEditor from '../components/LocalPostEditor.astro';
import { SITE, categoryToPath } from '../consts';
import { getSubcategoryInfo } from '../lib/categoryList';

const { post, prev, next, related } = Astro.props;
const Content = post.Content;
const data = post.data;
const isDev = import.meta.env.DEV;
const description = data.description.trim();
const metaDescription = description || SITE.description;
const canonical = new URL(`/posts/${post.id}/`, SITE.url).toString();
const updated = data.updated ?? data.date;
const subcategoryInfo = getSubcategoryInfo(data.category, data.subcategory);
const categoryLabel = subcategoryInfo?.name ?? data.category;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: metaDescription,
  url: canonical,
  image: new URL(data.image, SITE.url).toString(),
  datePublished: data.date.toISOString(),
  dateModified: updated.toISOString(),
  inLanguage: 'ko-KR',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical
  }
};
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: '홈', item: SITE.url },
  { '@type': 'ListItem', position: 2, name: data.category, item: new URL(categoryToPath[data.category], SITE.url).toString() }
];
if (subcategoryInfo) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: breadcrumbItems.length + 1,
    name: subcategoryInfo.name,
    item: new URL(subcategoryInfo.path, SITE.url).toString()
  });
}
breadcrumbItems.push({
  '@type': 'ListItem',
  position: breadcrumbItems.length + 1,
  name: data.title,
  item: canonical
});
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems
};
---
<BaseLayout title={`${data.title} | 단맥`} description={metaDescription} image={data.image} type="article" canonical={canonical}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>
  <main class="article-page article-page--guide">
    <div class="article-wrap">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">홈</a> <span aria-hidden="true">/</span> <a href={categoryToPath[data.category]}>{data.category}</a>
        {subcategoryInfo && <Fragment> <span aria-hidden="true">/</span> <a href={subcategoryInfo.path}>{subcategoryInfo.name}</a></Fragment>}
      </nav>
      <article>
        <header class="article-header">
          <h1>{data.title}</h1>
          {description && !data.hideDescription && <p class="description">{description}</p>}
          <div class="article-meta">
            <time datetime={data.date.toISOString()}>작성 {data.date.toLocaleDateString('ko-KR')}</time>
          </div>
          <div class="tag-list">
            {data.tags.map((tag: string) => <span>#{tag}</span>)}
          </div>
        </header>
        {!data.hideHeroImage && (
          <figure class="hero-image">
            <img src={data.image} alt={data.imageAlt} width={data.imageWidth} height={data.imageHeight} fetchpriority="high" decoding="async" />
          </figure>
        )}
        <div class="prose">
          <Content />
        </div>
        <ShareButtons title={data.title} />
        <nav class="post-nav" aria-label="이전 글과 다음 글">
          {prev && (
            <a class="button-link post-nav-link" href={`/posts/${prev.id}/`}>
              <img class="post-nav-thumb" src={prev.data.image} alt="" width={prev.data.imageWidth} height={prev.data.imageHeight} loading="lazy" decoding="async" />
              <span class="post-nav-text">← {prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="button-link post-nav-link post-nav-link--next" href={`/posts/${next.id}/`}>
              <span class="post-nav-text">{next.data.title} →</span>
              <img class="post-nav-thumb" src={next.data.image} alt="" width={next.data.imageWidth} height={next.data.imageHeight} loading="lazy" decoding="async" />
            </a>
          )}
        </nav>
      </article>
      <div style="text-align:center; padding-top:22px;">
        <a class="button-link" href="#top" style="display:inline-flex;">맨 위로 ↑</a>
      </div>
    </div>
    {isDev && <LocalPostEditor slug={post.id} />}
  </main>
  {related.length > 0 && (
    <section class="container related-section">
      <div class="section-head">
        <div>
          <h2>관련 {categoryLabel} 글</h2>
        </div>
      </div>
      <div class="grid">
        {related.map((item: any) => <PostCard post={item} />)}
      </div>
    </section>
  )}
</BaseLayout>
