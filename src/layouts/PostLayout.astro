---
import BaseLayout from '../components/BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, categoryToPath } from '../consts';

const { post, prev, next, related } = Astro.props;
const Content = post.Content;
const data = post.data;
const description = data.description.trim();
const metaDescription = description || SITE.description;
const canonical = new URL(`/posts/${post.id}/`, SITE.url).toString();
const updated = data.updated ?? data.date;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: metaDescription,
  image: new URL(data.image, SITE.url).toString(),
  datePublished: data.date.toISOString(),
  dateModified: updated.toISOString(),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  inLanguage: 'ko-KR',
  mainEntityOfPage: canonical
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: data.category, item: new URL(categoryToPath[data.category], SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonical }
  ]
};
---
<BaseLayout title={`${data.title} | 단맥`} description={metaDescription} image={data.image} type="article" canonical={canonical}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>
  <main class="article-page">
    <div class="article-wrap">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">홈</a> / <a href={categoryToPath[data.category]}>{data.category}</a>
      </nav>
      <article>
        <header class="article-header">
          <h1>{data.title}</h1>
          {description && !data.hideDescription && <p class="description">{description}</p>}
          <div class="article-meta">
            <time datetime={data.date.toISOString()}>작성 {data.date.toLocaleDateString('ko-KR')}</time>
          </div>
          <div class="tag-list">
            {data.tags.map((tag: string) => <span>#{tag}</span>)}
          </div>
        </header>
        {!data.hideHeroImage && (
          <figure class="hero-image">
            <img src={data.image} alt={data.imageAlt} width={data.imageWidth} height={data.imageHeight} fetchpriority="high" decoding="async" />
          </figure>
        )}
        <div class="prose">
          <Content />
        </div>
        <ShareButtons title={data.title} />
        <nav class="post-nav" aria-label="이전 글과 다음 글">
          {prev ? <a class="button-link" href={`/posts/${prev.id}/`}>← {prev.data.title}</a> : <span></span>}
          {next ? <a class="button-link" href={`/posts/${next.id}/`}>{next.data.title} →</a> : <span></span>}
        </nav>
        <div class="coupang-banner">
          <script is:inline src="https://ads-partners.coupang.com/g.js"></script>
          <script is:inline>
            new PartnersCoupang.G({"id":1021235,"trackingCode":"AF7638395","subId":null,"template":"carousel","width":"680","height":"140"});
          </script>
        </div>
      </article>
    </div>
  </main>
  {related.length > 0 && (
    <section class="container">
      <div class="section-head">
        <div>
          <h2>관련 글</h2>
          <p>이어서 읽기 좋은 단맥의 다른 글입니다.</p>
        </div>
      </div>
      <div class="grid">
        {related.map((item: any) => <PostCard post={item} />)}
      </div>
    </section>
  )}
</BaseLayout>
