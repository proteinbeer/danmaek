---
import { categoryToPath } from '../consts';

const { post } = Astro.props;
const data = post.data;
const link = categoryToPath[data.category] ?? '/it/';
const todayLabel = new Date().toDateString();
const yesterday = new Date();
yesterday.setDate(yesterday.getDate() - 1);
const yesterdayLabel = yesterday.toDateString();
const dateLabel = data.date.toDateString();
const badgeClass = dateLabel === todayLabel ? '' : ' new-badge--yesterday';
const showBadge = dateLabel === todayLabel || dateLabel === yesterdayLabel;
---
<article class="post-card" data-category={data.category} data-tags={data.tags.join(',')}>
  <a class="post-card__image" href={`/posts/${post.id}/`} aria-label={data.title}>
    <img src={data.image} alt={data.imageAlt} width={data.imageWidth} height={data.imageHeight} loading="lazy" decoding="async" />
    {showBadge && <span class={`new-badge${badgeClass}`}><span class="new-badge__text">NEW</span></span>}
  </a>
  <div class="post-card__meta">
    <a href={link}>{data.category}</a>
    <span> · </span>
    <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('ko-KR')}</time>
  </div>
  <h3><a href={`/posts/${post.id}/`}>{data.title}</a></h3>
</article>
