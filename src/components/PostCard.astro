---
import { categoryToPath, NEWS_SUBCATEGORIES, GUIDE_SUBCATEGORIES, COUPON_SUBCATEGORIES } from '../consts';
const { post } = Astro.props;
const data = post.data;
const label = data.subcategory || data.category;

const SUB_SLUG_BY_CATEGORY: Record<string, Map<string, string>> = {
  '뉴스': new Map(NEWS_SUBCATEGORIES.map((s) => [s.name, s.slug])),
  '가이드': new Map(GUIDE_SUBCATEGORIES.map((s) => [s.name, s.slug])),
  '쿠폰': new Map(COUPON_SUBCATEGORIES.map((s) => [s.name, s.slug]))
};
const subSlug = data.subcategory ? (SUB_SLUG_BY_CATEGORY[data.category]?.get(data.subcategory) ?? '') : '';
const link = subSlug
  ? `${categoryToPath[data.category] ?? '/news/'}${subSlug}/`
  : (data.category === '뉴스' ? '/news/' : categoryToPath[data.category]);
---
<article class="post-card" data-category={data.category} data-subcategory={data.subcategory}>
  <a class="post-card__image" href={`/posts/${post.id}/`} aria-label={data.title}>
    <img src={data.image} alt={data.imageAlt} width={data.imageWidth} height={data.imageHeight} loading="lazy" decoding="async" />
  </a>
  <div class="post-card__meta">
    <a href={link}>{label}</a>
    <span> · </span>
    <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('ko-KR')}</time>
  </div>
  <h3><a href={`/posts/${post.id}/`}>{data.title}</a></h3>
</article>
