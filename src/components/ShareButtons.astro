---
const { title } = Astro.props;
const pageUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(title);
---
<div class="share-row" aria-label="공유">
  <button class="share-button" type="button" data-native-share data-tooltip="카카오톡 공유" aria-label="카카오톡 공유" title="카카오톡 공유">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M12 4.25c-4.95 0-8.95 3.1-8.95 6.92 0 2.45 1.65 4.6 4.13 5.83l-.68 2.98c-.08.36.32.63.62.42l3.42-2.28c.48.05.97.08 1.46.08 4.95 0 8.95-3.1 8.95-7.03S16.95 4.25 12 4.25Z" />
    </svg>
  </button>
  <a class="share-button" href={`https://social-plugins.line.me/lineit/share?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" data-tooltip="LINE 공유" aria-label="LINE 공유" title="LINE 공유">
    <svg class="share-icon-stroke" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M12 3.9c-5.1 0-9.2 3.25-9.2 7.25 0 3.58 3.25 6.55 7.55 7.12l1.06 2.1c.2.38.73.43 1 .1l2.18-2.2c3.9-.8 6.61-3.6 6.61-7.12 0-4-4.1-7.25-9.2-7.25Z" />
      <path d="M7.35 9.15v4.15h2.5M10.75 9.15v4.15M12 9.15l2.2 4.15V9.15M17.35 9.15h-2.1v4.15h2.1M15.25 11.22h1.78" />
    </svg>
  </a>
  <a class="share-button" href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" data-tooltip="X 공유" aria-label="X 공유" title="X 공유">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M5 5.25h3.35l3.95 5.25 4.45-5.25H19l-5.58 6.55L19.3 19h-3.35l-4.32-5.75L6.75 19H4.5l6-7.05L5 5.25Z" />
    </svg>
  </a>
  <a class="share-button" href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" data-tooltip="Facebook 공유" aria-label="Facebook 공유" title="Facebook 공유">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M14.35 8.15h2.05V4.75c-.35-.05-1.55-.15-2.95-.15-2.92 0-4.92 1.8-4.92 5.08v2.85H5.25v3.8h3.28V22h4.02v-5.67h3.15l.5-3.8h-3.65V10.05c0-1.1.3-1.9 1.8-1.9Z" />
    </svg>
  </a>
  <a class="share-button" href={`https://www.threads.net/intent/post?text=${encodedTitle}%20${encodedUrl}`} target="_blank" rel="noopener noreferrer" data-tooltip="Threads 공유" aria-label="Threads 공유" title="Threads 공유">
    <svg class="share-icon-stroke" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M16.7 8.55c-.95-1.35-2.53-2.1-4.7-2.1-3.15 0-5.23 2.15-5.23 5.55 0 3.62 2.2 5.72 5.65 5.72 2.85 0 4.78-1.45 4.78-3.68 0-1.88-1.38-2.95-3.8-3.08h-1.52c-1.52 0-2.45.68-2.45 1.75 0 1.08.9 1.72 2.35 1.72 2.02 0 3.5-.86 4.2-2.34.48-1.02.45-2.55-.22-4.05" />
      <path d="M18.92 10.7c1.28.48 2.08 1.48 2.08 2.88 0 3.7-3.35 6.28-8.38 6.28-5.65 0-9.27-3.08-9.27-7.86 0-4.65 3.5-7.86 8.65-7.86 3.72 0 6.45 1.62 7.72 4.55" />
    </svg>
  </a>
  <button class="share-button" type="button" data-native-share data-tooltip="Instagram 공유" aria-label="Instagram 공유" title="Instagram 공유">
    <svg class="share-icon-stroke" aria-hidden="true" viewBox="0 0 24 24">
      <rect x="5.15" y="5.15" width="13.7" height="13.7" rx="4.2" />
      <circle cx="12" cy="12" r="3.15" />
      <circle cx="16.35" cy="7.75" r=".7" />
    </svg>
  </button>
  <button class="share-button" type="button" data-copy-share data-tooltip="링크 복사" aria-label="링크 복사" title="링크 복사">
    <svg class="share-icon-stroke" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M9.6 14.4 14.4 9.6" />
      <path d="M10.85 7.2 12 6.05a4.08 4.08 0 0 1 5.78 5.78l-1.15 1.15" />
      <path d="M13.15 16.8 12 17.95a4.08 4.08 0 0 1-5.78-5.78l1.15-1.15" />
    </svg>
  </button>
</div>
<script>
  const shareData = () => ({
    title: document.title,
    text: document.title,
    url: window.location.href
  });

  async function copyCurrentUrl(button: Element) {
    const target = button as HTMLButtonElement;
    const originalLabel = target.getAttribute('aria-label') || '링크 복사';
    const originalTooltip = target.getAttribute('data-tooltip') || originalLabel;
    try {
      await navigator.clipboard.writeText(window.location.href);
      target.setAttribute('aria-label', '링크 복사됨');
      target.setAttribute('title', '링크 복사됨');
      target.setAttribute('data-tooltip', '링크 복사됨');
      target.dataset.copied = 'true';
      setTimeout(() => {
        target.setAttribute('aria-label', originalLabel);
        target.setAttribute('title', originalTooltip);
        target.setAttribute('data-tooltip', originalTooltip);
        delete target.dataset.copied;
      }, 1600);
    } catch {
      target.setAttribute('aria-label', '링크 복사 실패');
      target.setAttribute('title', '링크 복사 실패');
      target.setAttribute('data-tooltip', '링크 복사 실패');
    }
  }

  document.querySelectorAll('[data-native-share]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share(shareData());
          return;
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
        }
      }
      await copyCurrentUrl(button);
    });
  });

  document.querySelectorAll('[data-copy-share]').forEach((button) => {
    button.addEventListener('click', () => copyCurrentUrl(button));
  });
</script>
