---
const { slug } = Astro.props;
---

<div class="local-post-editor" data-local-post-editor data-slug={slug}>
  <button class="local-post-editor__toggle" type="button" aria-expanded="false">편집</button>
  <section class="local-post-editor__panel" hidden aria-label="로컬 글 수정">
    <div class="local-post-editor__head">
      <div>
        <strong>편집</strong>
        <p>본문의 글을 수정합니다</p>
      </div>
      <button class="local-post-editor__close" type="button" aria-label="닫기">×</button>
    </div>
    <div class="local-post-editor__body">
      <label class="local-post-editor__title">
        <input type="text" data-editor-title aria-label="제목" />
      </label>
      <div class="local-post-editor__lines" data-editor-lines>
        <p class="local-post-editor__status">불러오는 중...</p>
      </div>
    </div>
    <div class="local-post-editor__actions">
      <button class="local-post-editor__save" type="button">저장</button>
      <span class="local-post-editor__message" data-editor-message></span>
    </div>
  </section>
</div>

<style>
  .local-post-editor {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 500;
    font-family: var(--font);
  }

  .local-post-editor__toggle,
  .local-post-editor__save,
  .local-post-editor__close {
    appearance: none;
    border: 1px solid #0d2b57;
    background: #0d2b57;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 900;
  }

  .local-post-editor__toggle {
    min-width: 74px;
    min-height: 46px;
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(13, 43, 87, .24);
  }

  .local-post-editor__panel {
    position: absolute;
    right: 0;
    bottom: 58px;
    width: min(688px, calc(100vw - 24px));
    max-height: min(760px, calc(100vh - 110px));
    overflow: hidden;
    border: 1px solid #d9dee7;
    border-top: 4px solid #0d2b57;
    border-radius: 16px;
    background: #fff;
    color: #111827;
    box-shadow: 0 24px 70px rgba(15, 23, 42, .22);
  }

  .local-post-editor__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 18px 14px;
    border-bottom: 1px solid #e5eaf2;
  }

  .local-post-editor__head strong {
    display: block;
    font-size: 1rem;
  }

  .local-post-editor__head p {
    margin: 5px 0 0;
    color: #64748b;
    font-size: .84rem;
    line-height: 1.5;
  }

  .local-post-editor__title {
    display: grid;
    width: 100%;
    min-width: 0;
  }

  .local-post-editor__title input {
    display: block;
    width: 100%;
    max-width: none;
    box-sizing: border-box;
    border: 1px solid #cfd6e2;
    border-radius: 16px;
    background: #eef2f7;
    color: #111827;
    font: inherit;
    font-size: .98rem;
    font-weight: 900;
    line-height: 1.4;
    padding: 10px 14px;
  }

  .local-post-editor__title input:focus {
    border-color: #0d2b57;
    outline: 3px solid rgba(13, 43, 87, .12);
  }

  .local-post-editor__close {
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    border-radius: 50%;
    padding: 0;
    line-height: 1;
  }

  .local-post-editor__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    max-height: min(560px, calc(100vh - 260px));
    overflow: auto;
    padding: 14px 8px;
    background: #f4f7fb;
  }

  .local-post-editor__lines {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }

  .local-post-editor__status {
    margin: 0;
    color: #64748b;
    font-size: .9rem;
    font-weight: 800;
  }

  :global(.local-post-editor__line) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    min-width: 0;
  }

  :global(.local-post-editor__line--heading:not(:first-child)) {
    margin-top: 20px;
  }

  :global(.local-post-editor__line textarea) {
    display: block;
    width: 100% !important;
    max-width: none !important;
    inline-size: 100% !important;
    min-width: 0;
    min-height: 42px;
    box-sizing: border-box;
    overflow: hidden;
    resize: vertical;
    border: 1px solid #d9dee7;
    border-radius: 16px;
    background: #fff;
    color: #111827;
    font: inherit;
    font-size: .94rem;
    line-height: 1.55;
    padding: 9px 14px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .03);
  }

  :global(.local-post-editor__line--heading textarea) {
    border-color: #cfd6e2;
    background: #eef2f7;
    font-weight: 900;
  }

  :global(.local-post-editor__line textarea:focus) {
    border-color: #0d2b57;
    outline: 3px solid rgba(13, 43, 87, .12);
  }

  :global(.danmaek-editor-target-highlight) {
    position: relative;
    z-index: 1;
    scroll-margin-top: 120px;
  }

  :global(.danmaek-editor-target-highlight::before) {
    content: "";
    position: absolute;
    inset: -10px -12px;
    z-index: -1;
    border: 3px solid rgba(13, 43, 87, .92);
    border-radius: 14px;
    background: rgba(13, 43, 87, .07);
    box-shadow:
      0 0 0 6px rgba(13, 43, 87, .08),
      0 0 26px rgba(13, 43, 87, .24);
    pointer-events: none;
    animation: danmaek-editor-glow 1.45s ease-in-out infinite;
  }

  @keyframes danmaek-editor-glow {
    0%,
    100% {
      box-shadow:
        0 0 0 5px rgba(13, 43, 87, .06),
        0 0 18px rgba(13, 43, 87, .18);
    }

    50% {
      box-shadow:
        0 0 0 9px rgba(13, 43, 87, .11),
        0 0 34px rgba(13, 43, 87, .34);
    }
  }

  .local-post-editor__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px 18px;
    border-top: 1px solid #e5eaf2;
    background: #fff;
  }

  .local-post-editor__save {
    min-height: 40px;
    border-radius: 999px;
    padding: 8px 16px;
  }

  .local-post-editor__message {
    color: #94a3b8;
    font-size: .84rem;
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .local-post-editor {
      right: 14px;
      bottom: 14px;
    }

    .local-post-editor__panel {
      right: -4px;
      bottom: 54px;
    }
  }
</style>

<script define:vars={{ slug }}>
  const root = document.querySelector('[data-local-post-editor]');
  const toggle = root?.querySelector('.local-post-editor__toggle');
  const panel = root?.querySelector('.local-post-editor__panel');
  const closeButton = root?.querySelector('.local-post-editor__close');
  const linesRoot = root?.querySelector('[data-editor-lines]');
  const titleInput = root?.querySelector('[data-editor-title]');
  const saveButton = root?.querySelector('.local-post-editor__save');
  const message = root?.querySelector('[data-editor-message]');

  if (sessionStorage.getItem('danmaek-editor-no-scroll') === '1') {
    sessionStorage.removeItem('danmaek-editor-no-scroll');
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    const resetScroll = () => window.scrollTo(0, 0);
    requestAnimationFrame(resetScroll);
    window.setTimeout(resetScroll, 80);
  }

  const setMessage = (text) => {
    if (message) message.textContent = text;
  };

  const makeTextareaHeight = (textarea) => {
    textarea.style.height = '0px';
    textarea.style.height = `${Math.max(42, textarea.scrollHeight)}px`;
  };

  const resizeAllTextareas = () => {
    linesRoot?.querySelectorAll('textarea').forEach((textarea) => makeTextareaHeight(textarea));
  };

  const normalizeText = (text) => String(text || '').replace(/\s+/g, ' ').trim();

  let highlightedTarget = null;

  const clearHighlight = () => {
    highlightedTarget?.classList.remove('danmaek-editor-target-highlight');
    highlightedTarget = null;
  };

  const findArticleTarget = (text) => {
    const needle = normalizeText(text);
    if (!needle) return null;
    const candidates = Array.from(document.querySelectorAll('.prose h2, .prose h3, .prose p, .prose li, .prose blockquote'));
    return candidates.find((element) => normalizeText(element.textContent) === needle)
      || candidates.find((element) => normalizeText(element.textContent).includes(needle));
  };

  const centerTarget = (target) => {
    const rect = target.getBoundingClientRect();
    const top = window.scrollY + rect.top;
    const y = top + (rect.height / 2) - (window.innerHeight / 2);
    window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
  };

  const showArticleTarget = (textarea) => {
    const target = findArticleTarget(textarea.value);
    if (!target) return;
    clearHighlight();
    highlightedTarget = target;
    target.classList.add('danmaek-editor-target-highlight');
    centerTarget(target);
  };

  const showTitleTarget = () => {
    const target = document.querySelector('.article-header h1');
    if (!target) return;
    clearHighlight();
    highlightedTarget = target;
    target.classList.add('danmaek-editor-target-highlight');
    centerTarget(target);
  };

  const loadLines = async () => {
    if (!linesRoot) return;
    linesRoot.innerHTML = '<p class="local-post-editor__status">불러오는 중...</p>';
    setMessage('');
    const response = await fetch(`/__local-editor/post?slug=${encodeURIComponent(slug)}`);
    const data = await response.json();
    if (!data.ok) throw new Error(data.error || '불러오기에 실패했습니다.');
    if (titleInput) titleInput.value = data.title || '';
    linesRoot.innerHTML = '';
    data.lines.forEach((line) => {
      const label = document.createElement('label');
      label.className = 'local-post-editor__line';
      const textarea = document.createElement('textarea');
      textarea.rows = 1;
      textarea.value = String(line.text ?? '').replace(/^\s*#{1,6}\s+/, '');
      textarea.dataset.index = String(line.index);
      textarea.dataset.prefix = String(line.prefix ?? '');
      if (textarea.dataset.prefix || /^\d+\.\s+\S/.test(textarea.value.trim())) {
        label.classList.add('local-post-editor__line--heading');
      }
      textarea.addEventListener('input', () => makeTextareaHeight(textarea));
      textarea.addEventListener('focus', () => showArticleTarget(textarea));
      textarea.addEventListener('blur', clearHighlight);
      label.append(textarea);
      linesRoot.append(label);
      requestAnimationFrame(() => requestAnimationFrame(() => makeTextareaHeight(textarea)));
    });
    if (!data.lines.length) {
      linesRoot.innerHTML = '<p class="local-post-editor__status">수정할 텍스트가 없습니다.</p>';
    }
  };

  const openPanel = async () => {
    if (!panel || !toggle) return;
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    try {
      await loadLines();
    } catch (error) {
      if (linesRoot) linesRoot.innerHTML = `<p class="local-post-editor__status">${error instanceof Error ? error.message : '불러오기에 실패했습니다.'}</p>`;
    }
  };

  const closePanel = () => {
    if (!panel || !toggle) return;
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', () => {
    if (panel?.hidden) openPanel();
    else closePanel();
  });
  closeButton?.addEventListener('click', closePanel);

  let autoSaveTimer = null;
  const autoSave = () => {
    clearTimeout(autoSaveTimer);
    autoSaveTimer = setTimeout(async () => {
      if (!linesRoot) return;
      const lines = Array.from(linesRoot.querySelectorAll('textarea')).map((textarea) => ({
        index: Number(textarea.dataset.index),
        text: textarea.value.replace(/^\s*#{1,6}\s+/, ''),
        prefix: textarea.dataset.prefix || (/^\d+\.\s+\S/.test(textarea.value.trim()) ? '## ' : '')
      }));
      const title = titleInput?.value || '';
      try {
        const response = await fetch(`/__local-editor/post?slug=${encodeURIComponent(slug)}&silent=1`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title, lines })
        });
        const data = await response.json();
        if (!data.ok) throw new Error(data.error || '저장에 실패했습니다.');
        const now = new Date();
        const h = now.getHours();
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        const period = h < 12 ? '오전' : '오후';
        const h12 = h % 12 || 12;
        setMessage(`자동 저장 완료 (${period} ${h12}:${m}:${s})`);
      } catch (error) {
        setMessage(error instanceof Error ? error.message : '저장 실패');
      }
    }, 600);
  };

  saveButton?.addEventListener('click', async () => {
    if (!linesRoot) return;
    const lines = Array.from(linesRoot.querySelectorAll('textarea')).map((textarea) => ({
      index: Number(textarea.dataset.index),
      text: textarea.value.replace(/^\s*#{1,6}\s+/, ''),
      prefix: textarea.dataset.prefix || (/^\d+\.\s+\S/.test(textarea.value.trim()) ? '## ' : '')
    }));
    const title = titleInput?.value || '';
    saveButton.disabled = true;
    setMessage('저장 중...');
    try {
      const response = await fetch(`/__local-editor/post?slug=${encodeURIComponent(slug)}`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ title, lines })
      });
      const data = await response.json();
      if (!data.ok) throw new Error(data.error || '저장에 실패했습니다.');
      setMessage('저장 완료. 새로고침합니다.');
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      sessionStorage.setItem('danmaek-editor-no-scroll', '1');
      window.location.reload();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : '저장에 실패했습니다.');
    } finally {
      saveButton.disabled = false;
    }
  });

  linesRoot?.addEventListener('input', autoSave);
  titleInput?.addEventListener('input', autoSave);
  titleInput?.addEventListener('focus', showTitleTarget);
  titleInput?.addEventListener('blur', clearHighlight);

  if (typeof ResizeObserver !== 'undefined' && linesRoot) {
    const observer = new ResizeObserver(resizeAllTextareas);
    observer.observe(linesRoot);
  }
</script>
