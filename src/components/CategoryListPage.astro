---
import BaseLayout from './BaseLayout.astro';
import PostCard from './PostCard.astro';
import {
  CATEGORIES,
  SITE,
  GAME_SUBCATEGORIES,
  GAME_NAME_TAGS,
  IT_SUBCATEGORIES,
  type Subcategory
} from '../consts';
import {
  LIST_PER_PAGE,
  categoryListPageUrl,
  categorySlug,
  getCategoryListPosts,
  type ListCategory
} from '../lib/categoryList';

const { category, page } = Astro.props as { category: ListCategory; page: number };

const categoryMeta = CATEGORIES.find((item) => item.name === category)!;
const isGames = category === '게임';
const subcats: Subcategory[] = isGames ? [...GAME_SUBCATEGORIES] : [...IT_SUBCATEGORIES];
const base = categorySlug[category];
const list = getCategoryListPosts(category);
const gameTagOptions = isGames
  ? GAME_NAME_TAGS.filter((name) => list.some((post) => post.data.tags.includes(name)))
  : [];
const totalPages = Math.max(1, Math.ceil(list.length / LIST_PER_PAGE));
const pagePosts = list.slice((page - 1) * LIST_PER_PAGE, page * LIST_PER_PAGE);
const canonical = new URL(categoryListPageUrl(category, page), SITE.url).toString();
const pageTitle = page === 1 ? `${category} | ${SITE.name}` : `${category} ${page}페이지 | ${SITE.name}`;
const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
---
<BaseLayout title={pageTitle} description={categoryMeta.description} canonical={canonical}>
  <main class="container">
    <div class="adfit-banner">
      <ins class="kakao_ad_area" style="display:none;"
        data-ad-unit="DAN-LoWQpAjT1C8qjOLo"
        data-ad-width="728"
        data-ad-height="90"></ins>
      <script is:inline async type="text/javascript" charset="utf-8" src="https://t1.kakaocdn.net/kas/static/ba.min.js"></script>
    </div>
    <section aria-label={`${category} 글 목록`}>
      <div class="section-head">
        <div>
          <h2>{category}</h2>
          {isGames && <p>직접 플레이하면서 확인한 게임 공략, 설정 방법, 문제 해결 및 플레이 팁을 모았습니다.</p>}
        </div>
        <div class="section-head__controls">
          <div class="sub-drop" id="guide-sub-drop">
            <button type="button" class="sub-filter" id="guide-sub-trigger" aria-haspopup="listbox" aria-expanded="false">전체</button>
            <div class="sub-dropdown" role="listbox" id="guide-sub-list">
              <a class="sub-dropdown-item" href={`/${base}/`}>전체</a>
              {subcats.map((sub) => <a class="sub-dropdown-item" href={`/${base}/${sub.slug}/`}>{sub.name}</a>)}
            </div>
          </div>
          {isGames && (
            <div class="sub-drop" id="guide-game-drop">
              <button type="button" class="sub-filter" id="guide-game-trigger" aria-haspopup="listbox" aria-expanded="false">게임 선택</button>
              <div class="sub-dropdown" role="listbox" id="guide-game-list">
                <button type="button" class="sub-dropdown-item" data-game="">전체</button>
                {gameTagOptions.map((name) => <button type="button" class="sub-dropdown-item" data-game={name}>{name}</button>)}
              </div>
            </div>
          )}
          <input id="guide-search" class="home-search-input" type="search" placeholder="검색" aria-label={`${category} 검색`} autocomplete="off" />
        </div>
      </div>
      <div class="grid" id="post-grid">
        {pagePosts.map((post) => <PostCard post={post} />)}
      </div>
      {totalPages > 1 && (
        <nav class="pagination" aria-label="페이지">
          {page > 1
            ? <a class="pagination__btn" href={categoryListPageUrl(category, page - 1)}>이전</a>
            : <span class="pagination__btn" aria-disabled="true">이전</span>}
          {pageNumbers.map((num) => (
            num === page
              ? <a class="pagination__btn is-current" aria-current="page" href={categoryListPageUrl(category, num)}>{num}</a>
              : <a class="pagination__btn" href={categoryListPageUrl(category, num)}>{num}</a>
          ))}
          {page < totalPages
            ? <a class="pagination__btn" href={categoryListPageUrl(category, page + 1)}>다음</a>
            : <span class="pagination__btn" aria-disabled="true">다음</span>}
        </nav>
      )}
    </section>
  </main>
  <script>
    const grid = document.getElementById('post-grid') as HTMLElement;
    const allCards = Array.from(grid?.children ?? []) as HTMLElement[];
    const search = document.getElementById('guide-search') as HTMLInputElement;
    const trigger = document.getElementById('guide-sub-trigger') as HTMLButtonElement;
    const list = document.getElementById('guide-sub-list') as HTMLElement;
    const clampList = () => {
      const r = list.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      const dx = Math.max(8 - r.left, Math.min(0, vw - 8 - r.right));
      if (dx === 0) { list.style.left = ''; return; }
      list.style.left = `${dx}px`;
    };
    const open = () => { list.classList.add('open'); trigger.setAttribute('aria-expanded', 'true'); clampList(); };
    const close = () => { list.classList.remove('open'); trigger.setAttribute('aria-expanded', 'false'); list.style.left = ''; };
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      list.classList.contains('open') ? close() : open();
    });
    document.addEventListener('click', (e) => {
      if (!list?.contains(e.target as Node)) close();
    });

    const gameTrigger = document.getElementById('guide-game-trigger') as HTMLButtonElement | null;
    const gameList = document.getElementById('guide-game-list') as HTMLElement | null;
    let activeGame = '';
    const clampGameList = () => {
      if (!gameList) return;
      const r = gameList.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      const dx = Math.max(8 - r.left, Math.min(0, vw - 8 - r.right));
      if (dx === 0) { gameList.style.left = ''; return; }
      gameList.style.left = `${dx}px`;
    };
    const openGame = () => { gameList?.classList.add('open'); gameTrigger?.setAttribute('aria-expanded', 'true'); clampGameList(); };
    const closeGame = () => { gameList?.classList.remove('open'); gameTrigger?.setAttribute('aria-expanded', 'false'); if (gameList) gameList.style.left = ''; };
    gameTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      gameList?.classList.contains('open') ? closeGame() : openGame();
    });
    document.addEventListener('click', (e) => {
      if (!gameList?.contains(e.target as Node)) closeGame();
    });
    gameList?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-game]') as HTMLButtonElement | null;
      if (!btn) return;
      activeGame = btn.dataset.game ?? '';
      if (gameTrigger) gameTrigger.textContent = activeGame || '게임 선택';
      closeGame();
      filterGuides();
    });

    function filterGuides() {
      const q = (search?.value || '').trim().toLowerCase();
      allCards.forEach((card) => {
        const matchesQ = !q || card.textContent?.toLowerCase().includes(q);
        const matchesGame = !activeGame || (card.dataset.tags || '').split(',').map((t) => t.trim()).includes(activeGame);
        card.style.display = matchesQ && matchesGame ? '' : 'none';
      });
    }
    search?.addEventListener('input', filterGuides);
  </script>
</BaseLayout>