---
import BaseLayout from './BaseLayout.astro';
import PostCard from './PostCard.astro';
import { CATEGORIES, IT_SUBCATEGORIES, SITE } from '../consts';
import {
  categoryListPageUrl,
  getCategoryListPosts,
  LIST_PER_PAGE,
  subcategoryPath,
  type ListCategory
} from '../lib/categoryList';
import { getPostsBySubcategory } from '../lib/posts';

const { category, page, subcategory, subcategorySlug } = Astro.props as {
  category: ListCategory;
  page: number;
  subcategory?: string;
  subcategorySlug?: string;
};
const categoryMeta = CATEGORIES.find((item) => item.name === category)!;
const list = subcategory ? getPostsBySubcategory(category, subcategory) : getCategoryListPosts(category);
const totalPages = Math.max(1, Math.ceil(list.length / LIST_PER_PAGE));
const pagePosts = list.slice((page - 1) * LIST_PER_PAGE, page * LIST_PER_PAGE);
const heading = subcategory ?? category;
const pageDescription = subcategory
  ? (IT_SUBCATEGORIES.find((item) => item.name === subcategory)?.description ?? '')
  : categoryMeta.description;
const canonical = new URL(
  subcategory && subcategorySlug ? subcategoryPath(category, subcategorySlug) : categoryListPageUrl(category, page),
  SITE.url
).toString();
const pageTitle = page === 1 ? `${heading} | ${SITE.name}` : `${heading} ${page}페이지 | ${SITE.name}`;
const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
---
<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <main class="container">
    <section aria-label={`${heading} 글 목록`}>
      <div class="section-head">
        <div>
          <h2>{heading}</h2>
          <p>{pageDescription}</p>
        </div>
        <div class="section-head__controls">
          <input id="guide-search" class="home-search-input" type="search" placeholder="검색" aria-label={`${heading} 검색`} autocomplete="off" />
        </div>
      </div>
      <div class="grid" id="post-grid">
        {pagePosts.map((post) => <PostCard post={post} />)}
      </div>
      {totalPages > 1 && (
        <nav class="pagination" aria-label="페이지">
          {page > 1
            ? <a class="pagination__btn" href={categoryListPageUrl(category, page - 1)}>이전</a>
            : <span class="pagination__btn" aria-disabled="true">이전</span>}
          {pageNumbers.map((num) => (
            num === page
              ? <a class="pagination__btn is-current" aria-current="page" href={categoryListPageUrl(category, num)}>{num}</a>
              : <a class="pagination__btn" href={categoryListPageUrl(category, num)}>{num}</a>
          ))}
          {page < totalPages
            ? <a class="pagination__btn" href={categoryListPageUrl(category, page + 1)}>다음</a>
            : <span class="pagination__btn" aria-disabled="true">다음</span>}
        </nav>
      )}
    </section>
  </main>
  <script>
    const grid = document.getElementById('post-grid') as HTMLElement;
    const allCards = Array.from(grid?.children ?? []) as HTMLElement[];
    const search = document.getElementById('guide-search') as HTMLInputElement;

    function filterGuides() {
      const q = (search?.value || '').trim().toLowerCase();
      allCards.forEach((card) => {
        const matchesQ = !q || card.textContent?.toLowerCase().includes(q);
        card.style.display = matchesQ ? '' : 'none';
      });
    }
    search?.addEventListener('input', filterGuides);
  </script>
</BaseLayout>
