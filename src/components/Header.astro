---
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="단맥 홈">
      <img src="/images/brand/logo-ko.png" alt="" width="128" height="96" decoding="async" />
    </a>
    <a class={`button-link header-search`} href="/search/" aria-current={path.startsWith('/search/') ? 'page' : undefined}>검색</a>
  </div>
</header>
