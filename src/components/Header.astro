---
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="단맥 홈">
      <span class="brand-mark" aria-hidden="true">
        <img src="/assets/danmaek-logo.png" alt="" width="40" height="40" />
      </span>
    </a>
    <nav class="nav" aria-label="주요 메뉴">
      <a href="/it/" aria-current={path.startsWith('/it/') ? 'page' : undefined}>IT</a>
      <a href="/games/" aria-current={path.startsWith('/games/') ? 'page' : undefined}>게임</a>
      <a href="/tools/" aria-current={path.startsWith('/tools/') ? 'page' : undefined}>도구</a>
    </nav>
    <a class={`button-link header-search`} href="/search/" aria-label="검색" aria-current={path.startsWith('/search/') ? 'page' : undefined}>
      <img src="/assets/search.png" alt="" aria-hidden="true" width="26" height="26" />
    </a>
  </div>
</header>
