---
import { COUPON_SUBCATEGORIES, GUIDE_SUBCATEGORIES, NEWS_SUBCATEGORIES, TOOL_SUBCATEGORIES } from '../consts';

const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="단맥 홈">
      <span class="brand-mark" aria-hidden="true">
        <img src="/assets/danmaek-logo.png" alt="" width="40" height="40" />
      </span>
    </a>
    <nav class="nav" aria-label="주요 메뉴">
      <div class="nav-item">
        <a href="/news/" aria-current={path.startsWith('/news/') ? 'page' : undefined} class="nav-item__link">뉴스</a>
        <div class="nav-dropdown">
          {NEWS_SUBCATEGORIES.map((sub) => (
            <a href={`/news/${sub.slug}/`} aria-current={path.startsWith(`/news/${sub.slug}/`) ? 'page' : undefined}>{sub.name}</a>
          ))}
        </div>
      </div>
      <div class="nav-item">
        <a href="/guides/" aria-current={path.startsWith('/guides/') ? 'page' : undefined} class="nav-item__link">가이드</a>
        <div class="nav-dropdown">
          {GUIDE_SUBCATEGORIES.map((sub) => (
            <a href={`/guides/${sub.slug}/`} aria-current={path.startsWith(`/guides/${sub.slug}/`) ? 'page' : undefined}>{sub.name}</a>
          ))}
        </div>
      </div>
      <div class="nav-item">
        <a href="/coupons/" aria-current={path.startsWith('/coupons/') ? 'page' : undefined} class="nav-item__link">쿠폰</a>
        <div class="nav-dropdown">
          {COUPON_SUBCATEGORIES.map((sub) => (
            <a href={`/coupons/${sub.slug}/`} aria-current={path.startsWith(`/coupons/${sub.slug}/`) ? 'page' : undefined}>{sub.name}</a>
          ))}
        </div>
      </div>
      <div class="nav-item">
        <a href="/tools/" aria-current={path.startsWith('/tools/') ? 'page' : undefined} class="nav-item__link">도구</a>
        <div class="nav-dropdown">
          {TOOL_SUBCATEGORIES.map((sub) => (
            <a href={`/tools/${sub.slug}/`} aria-current={path.startsWith(`/tools/${sub.slug}/`) ? 'page' : undefined}>{sub.name}</a>
          ))}
        </div>
      </div>
    </nav>
    <a class={`button-link header-search`} href="/search/" aria-label="검색" aria-current={path.startsWith('/search/') ? 'page' : undefined}>
      <img src="/assets/search.png" alt="" aria-hidden="true" width="26" height="26" />
    </a>
  </div>
</header>
